<odoo>
<record id="subscription_company_rule" model="ir.rule"><field name="name">Contratos por organización</field><field name="model_id" ref="model_erpec_subscription"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="link_company_rule" model="ir.rule"><field name="name">Vínculos por organización</field><field name="model_id" ref="model_erpec_product_link"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="plan_list" model="ir.ui.view"><field name="name">erpec.plan.list</field><field name="model">erpec.plan</field><field name="arch" type="xml"><list><field name="name"/><field name="code"/><field name="version"/><field name="erp"/><field name="payroll"/><field name="invoicing"/><field name="api_access"/><field name="max_connections"/><field name="price"/><field name="published"/></list></field></record>
<record id="plan_form" model="ir.ui.view"><field name="name">erpec.plan.form</field><field name="model">erpec.plan</field><field name="arch" type="xml"><form><header><button name="action_new_version" type="object" string="Crear nueva versión"/></header><sheet><h1><field name="name" placeholder="Nombre del plan"/></h1><group><field name="code"/><field name="version"/></group><group string="Autoservicio"><field name="currency_id" invisible="1"/><field name="price"/><field name="published"/></group><group string="Productos contratados"><field name="erp"/><field name="payroll"/><field name="invoicing"/></group><group string="Acceso y límites"><field name="api_access"/><field name="max_connections" invisible="not api_access"/><field name="requests_per_minute" invisible="not api_access"/><field name="max_users"/><field name="max_companies"/></group><field name="terms" placeholder="Tarifa acordada, periodicidad, soporte y condiciones del contrato"/><div role="status" class="alert alert-info mt-3">Contratar productos no verifica conexiones. Una versión utilizada no se modifica: crea otra versión y revisa cada migración. Publicar un plan (con precio &gt; 0) lo expone en la landing pública de autoservicio.</div></sheet></form></field></record>
<record id="subscription_list" model="ir.ui.view"><field name="name">erpec.subscription.list</field><field name="model">erpec.subscription</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="plan_id"/><field name="ends_on"/><field name="state"/><field name="billing_owner"/></list></field></record>
<record id="subscription_form" model="ir.ui.view"><field name="name">erpec.subscription.form</field><field name="model">erpec.subscription</field><field name="arch" type="xml"><form><header><button name="action_activate" type="object" string="Autorizar alta comercial" class="btn-primary" invisible="activated_at"/><button name="action_suspend" type="object" string="Suspender" invisible="not activated_at or suspended"/><button name="action_resume" type="object" string="Reactivar" invisible="not activated_at or not suspended"/><field name="state" widget="statusbar"/></header><sheet><h1><field name="name" readonly="activated_at"/></h1><group><field name="company_id" readonly="activated_at"/><field name="plan_id" readonly="activated_at"/><field name="starts_on" readonly="activated_at"/><field name="ends_on" readonly="activated_at"/></group><group string="Cobro y autorización"><field name="billing_owner" readonly="activated_at"/><field name="billing_reference" readonly="activated_at"/><field name="authorization" readonly="activated_at"/><field name="activated_at"/><field name="activated_by"/><field name="suspended" invisible="1"/><field name="correlation_id"/></group><group string="Acceso efectivo"><field name="rights" nolabel="1"/></group><div role="status" class="alert alert-info">El alta registra derechos comerciales locales. No ejecuta un cargo, no acredita un pago y no crea acceso en los productos externos. Conserva el contrato anterior hasta acordar su sustitución.</div></sheet></form></field></record>
<record id="link_list" model="ir.ui.view"><field name="name">erpec.product.link.list</field><field name="model">erpec.product.link</field><field name="arch" type="xml"><list><field name="company_id"/><field name="product"/><field name="external_id"/><field name="status"/></list></field></record>
<record id="link_form" model="ir.ui.view"><field name="name">erpec.product.link.form</field><field name="model">erpec.product.link</field><field name="arch" type="xml"><form><sheet><group><field name="company_id"/><field name="product"/><field name="external_id"/><field name="authorization"/><field name="status"/></group><div role="status" class="alert alert-warning">Pendiente: configurar credenciales por empresa y verificar la conexión con el administrador del producto. No vincular solamente por correo o RUC.</div></sheet></form></field></record>
<record id="plans_action" model="ir.actions.act_window"><field name="name">Planes y versiones</field><field name="res_model">erpec.plan</field><field name="view_mode">list,form</field></record>
<record id="subscriptions_action" model="ir.actions.act_window"><field name="name">Contratos y derechos</field><field name="res_model">erpec.subscription</field><field name="view_mode">list,form</field></record>
<record id="links_action" model="ir.actions.act_window"><field name="name">Vínculos de productos</field><field name="res_model">erpec.product.link</field><field name="view_mode">list,form</field></record>
<menuitem id="plans_menu" name="Planes y versiones" parent="erpec_base.suite_root" action="plans_action" sequence="10"/>
<menuitem id="subscriptions_menu" name="Contratos y derechos" parent="erpec_base.suite_root" action="subscriptions_action" sequence="20"/>
<menuitem id="links_menu" name="Vínculos de productos" parent="erpec_base.suite_root" action="links_action" sequence="30"/>
</odoo>
