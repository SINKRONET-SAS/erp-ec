<odoo>
<record id="plan_catalog_form" model="ir.ui.view"><field name="name">Plan comercial configurable</field><field name="model">erpec.plan</field><field name="inherit_id" ref="erpec_suite.plan_form"/><field name="arch" type="xml">
<xpath expr="//field[@name='max_users']" position="attributes"><attribute name="string">Usuarios incluidos</attribute></xpath>
<xpath expr="//field[@name='price']" position="after"><field name="company_id"/><field name="annual_enabled"/><field name="annual_price" invisible="not annual_enabled"/><field name="tax_ids" widget="many2many_tags"/><field name="fiscal_reviewed"/></xpath>
<xpath expr="//field[@name='max_users']" position="after"><field name="user_limit"/><field name="additional_user_price"/><field name="additional_user_annual_price" invisible="not annual_enabled"/></xpath>
<xpath expr="//field[@name='terms']" position="before"><group string="Módulos internos del ERP"><field name="option_ids" nolabel="1"><list editable="bottom"><field name="capability_id"/><field name="kind"/><field name="currency_id" column_invisible="True"/><field name="monthly_price" readonly="kind == 'included'"/><field name="annual_price" readonly="kind == 'included'"/></list></field></group></xpath>
</field></record>
<record id="subscription_catalog_form" model="ir.ui.view"><field name="name">Condiciones comerciales del contrato</field><field name="model">erpec.subscription</field><field name="inherit_id" ref="erpec_suite.subscription_form"/><field name="arch" type="xml"><xpath expr="//field[@name='plan_id']" position="after"><field name="period" readonly="activated_at"/><field name="user_quantity" readonly="activated_at"/><field name="selected_option_ids" widget="many2many_tags" domain="[('plan_id','=',plan_id),('kind','=','optional')]" readonly="activated_at"/><field name="quoted_total"/><field name="renewal_of_id" readonly="1"/><field name="starts_on_activation" readonly="1"/><field name="commercial_snapshot" groups="base.group_system"/></xpath></field></record>
<record id="capability_action" model="ir.actions.act_window"><field name="name">Capacidades del ERP</field><field name="res_model">erpec.capability</field><field name="view_mode">list,form</field></record>
<menuitem id="capability_menu" name="Capacidades del ERP" parent="erpec_base.suite_root" action="capability_action" sequence="8" groups="base.group_system"/>
</odoo>
