<odoo>
<record id="activity_list" model="ir.ui.view"><field name="name">erpec.data.processing.activity.list</field><field name="model">erpec.data.processing.activity</field><field name="arch" type="xml"><list><field name="name"/><field name="legal_basis"/><field name="responsible_id"/><field name="special_category_data"/><field name="cross_border_transfer"/><field name="state"/></list></field></record>
<record id="activity_form" model="ir.ui.view"><field name="name">erpec.data.processing.activity.form</field><field name="model">erpec.data.processing.activity</field><field name="arch" type="xml"><form>
<header><field name="state" widget="statusbar"/></header>
<sheet>
<div class="alert alert-info" role="status">Registro de actividades de tratamiento (RAT) conforme a la Ley Orgánica de Protección de Datos Personales (LOPDP).</div>
<group><field name="name"/><field name="company_id"/><field name="responsible_id"/></group>
<group string="Tratamiento"><field name="purpose"/><field name="legal_basis"/><field name="data_subjects"/><field name="data_categories"/><field name="special_category_data"/></group>
<group string="Destino y conservación"><field name="recipients"/><field name="retention_period"/><field name="security_measures"/></group>
<group string="Transferencia internacional"><field name="cross_border_transfer"/><field name="transfer_country" invisible="not cross_border_transfer"/><field name="transfer_mechanism" invisible="not cross_border_transfer"/></group>
<group><field name="notes"/></group>
</sheet><chatter/></form></field></record>
<record id="activity_action" model="ir.actions.act_window"><field name="name">Registro de actividades de tratamiento (RAT)</field><field name="res_model">erpec.data.processing.activity</field><field name="view_mode">list,form</field></record>
<menuitem id="data_protection_menu" name="Protección de datos" parent="erpec_base.suite_root" groups="group_data_protection_officer" sequence="90"/>
<menuitem id="activity_menu" name="Registro de tratamiento (RAT)" parent="data_protection_menu" action="activity_action" sequence="10"/>
<record id="subject_request_list" model="ir.ui.view"><field name="name">erpec.data.subject.request.list</field><field name="model">erpec.data.subject.request</field><field name="arch" type="xml"><list decoration-danger="is_overdue"><field name="name"/><field name="request_type"/><field name="requester_name"/><field name="received_date"/><field name="deadline_date"/><field name="responsible_id"/><field name="state"/><field name="is_overdue" column_invisible="1"/></list></field></record>
<record id="subject_request_form" model="ir.ui.view"><field name="name">erpec.data.subject.request.form</field><field name="model">erpec.data.subject.request</field><field name="arch" type="xml"><form>
<header>
<button name="action_start" type="object" string="Iniciar trámite" class="oe_highlight" invisible="state != 'new'"/>
<button name="action_mark_answered" type="object" string="Marcar como respondida" class="oe_highlight" invisible="state not in ('new','in_progress')"/>
<button name="action_reject" type="object" string="Rechazar" invisible="state not in ('new','in_progress')"/>
<button name="action_close" type="object" string="Cerrar" invisible="state not in ('answered','rejected')"/>
<field name="state" widget="statusbar" statusbar_visible="new,in_progress,answered,closed"/>
</header>
<sheet>
<div class="alert alert-warning" role="status" invisible="not is_overdue">Esta solicitud superó el plazo de respuesta (Art. 13-16 LOPDP).</div>
<div class="alert alert-info" role="status">Solicitud de ejercicio de derechos del titular (LOPDP, Arts. 13-19).</div>
<group><field name="name"/><field name="company_id"/><field name="responsible_id"/></group>
<group string="Titular"><field name="requester_name"/><field name="requester_identification"/><field name="requester_email"/><field name="partner_id"/><field name="identity_verified"/><field name="channel"/></group>
<group string="Solicitud"><field name="request_type"/><field name="description"/><field name="received_date"/><field name="deadline_date"/></group>
<div class="alert alert-warning" role="status" invisible="not retention_blockers"><strong>Conservación obligatoria.</strong> <field name="retention_blockers" nolabel="1"/></div>
<group string="Conservación y bloqueo legal" invisible="request_type != 'eliminacion'"><field name="legal_hold"/><field name="legal_hold_reason" invisible="not legal_hold" required="legal_hold"/></group>
<group string="Resolución"><field name="response_date"/><field name="response_notes"/><field name="exception_notes"/></group>
<group><field name="notes"/></group>
</sheet><chatter/></form></field></record>
<record id="subject_request_search" model="ir.ui.view"><field name="name">erpec.data.subject.request.search</field><field name="model">erpec.data.subject.request</field><field name="arch" type="xml"><search>
<field name="requester_name"/><field name="request_type"/><field name="responsible_id"/>
<filter string="Vencidas" name="overdue" domain="[('deadline_date','&lt;', context_today().strftime('%Y-%m-%d')), ('state','not in', ['answered','rejected','closed'])]"/>
<filter string="Abiertas" name="open" domain="[('state','not in', ['closed'])]"/>
<group expand="0" string="Agrupar por"><filter string="Derecho" name="group_type" context="{'group_by':'request_type'}"/><filter string="Estado" name="group_state" context="{'group_by':'state'}"/></group>
</search></field></record>
<record id="subject_request_action" model="ir.actions.act_window"><field name="name">Solicitudes de derechos del titular</field><field name="res_model">erpec.data.subject.request</field><field name="view_mode">list,form</field><field name="search_view_id" ref="subject_request_search"/><field name="context">{'search_default_open': 1}</field></record>
<menuitem id="subject_request_menu" name="Solicitudes de derechos" parent="data_protection_menu" action="subject_request_action" sequence="20"/>
<record id="breach_incident_list" model="ir.ui.view"><field name="name">erpec.data.breach.incident.list</field><field name="model">erpec.data.breach.incident</field><field name="arch" type="xml"><list decoration-danger="is_authority_notice_overdue or is_titular_notice_overdue"><field name="name"/><field name="detected_date"/><field name="discovered_by"/><field name="risk_to_rights"/><field name="authority_notice_deadline"/><field name="responsible_id"/><field name="state"/><field name="is_authority_notice_overdue" column_invisible="1"/><field name="is_titular_notice_overdue" column_invisible="1"/></list></field></record>
<record id="breach_incident_form" model="ir.ui.view"><field name="name">erpec.data.breach.incident.form</field><field name="model">erpec.data.breach.incident</field><field name="arch" type="xml"><form>
<header>
<button name="action_start_assessment" type="object" string="Iniciar evaluación" class="oe_highlight" invisible="state != 'draft'"/>
<button name="action_notify_authority" type="object" string="Notificar a la Autoridad" class="oe_highlight" invisible="state not in ('draft','assessing') or authority_notified_date"/>
<button name="action_notify_titular" type="object" string="Notificar al titular" invisible="not risk_to_rights or titular_notified_date"/>
<button name="action_close" type="object" string="Cerrar" invisible="state not in ('notified',) or state == 'closed'"/>
<field name="state" widget="statusbar" statusbar_visible="draft,assessing,notified,closed"/>
</header>
<sheet>
<div class="alert alert-warning" role="status" invisible="not is_authority_notice_overdue">La notificación a la Autoridad de Protección de Datos superó el plazo de 5 días (Art. 43 LOPDP).</div>
<div class="alert alert-warning" role="status" invisible="not is_titular_notice_overdue">La notificación al titular superó el plazo de 3 días (Art. 46 LOPDP).</div>
<div class="alert alert-info" role="status">Registro de incidente de vulneración de seguridad de datos personales (LOPDP, Arts. 43 y 46).</div>
<group><field name="name"/><field name="company_id"/><field name="responsible_id"/></group>
<group string="Detección"><field name="discovered_by"/><field name="detected_date"/><field name="encargado_notice_date" invisible="discovered_by != 'encargado'"/><field name="encargado_notice_deadline" invisible="discovered_by != 'encargado'"/></group>
<group string="Descripción"><field name="description"/><field name="affected_data_categories"/><field name="affected_subjects_estimate"/><field name="containment_measures"/><field name="internal_risk_triage"/></group>
<group string="Notificación a la Autoridad (Art. 43 LOPDP)"><field name="authority_notice_deadline"/><field name="authority_notified_date"/></group>
<group string="Notificación al titular (Art. 46 LOPDP)"><field name="risk_to_rights"/><field name="titular_notice_deadline" invisible="not risk_to_rights"/><field name="titular_notified_date" invisible="not risk_to_rights"/><field name="titular_notice_exception" invisible="not risk_to_rights"/></group>
<group><field name="notes"/></group>
</sheet><chatter/></form></field></record>
<record id="breach_incident_search" model="ir.ui.view"><field name="name">erpec.data.breach.incident.search</field><field name="model">erpec.data.breach.incident</field><field name="arch" type="xml"><search>
<field name="name"/><field name="responsible_id"/>
<filter string="Notificación a la Autoridad vencida" name="authority_overdue" domain="[('authority_notified_date','=',False), ('authority_notice_deadline','&lt;', datetime.datetime.now())]"/>
<filter string="Abiertos" name="open" domain="[('state','!=','closed')]"/>
<group expand="0" string="Agrupar por"><filter string="Estado" name="group_state" context="{'group_by':'state'}"/></group>
</search></field></record>
<record id="breach_incident_action" model="ir.actions.act_window"><field name="name">Incidentes de seguridad (brechas)</field><field name="res_model">erpec.data.breach.incident</field><field name="view_mode">list,form</field><field name="search_view_id" ref="breach_incident_search"/><field name="context">{'search_default_open': 1}</field></record>
<menuitem id="breach_incident_menu" name="Incidentes de seguridad (brechas)" parent="data_protection_menu" action="breach_incident_action" sequence="30"/>
<record id="partner_marketing_opt_out" model="ir.ui.view"><field name="name">res.partner.erpec.data.protection</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/><field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside"><button name="action_ec_mark_marketing_opt_out" type="object" string="Excluir de correo comercial" class="oe_stat_button" icon="fa-envelope-o" invisible="ec_marketing_email_opt_out" groups="erpec_data_protection.group_data_protection_officer"/></xpath><xpath expr="//div[@name='button_box']" position="inside"><field name="ec_marketing_email_opt_out" invisible="1"/></xpath></field></record>
<record id="processor_list" model="ir.ui.view"><field name="name">erpec.data.processor.list</field><field name="model">erpec.data.processor</field><field name="arch" type="xml"><list><field name="name"/><field name="role"/><field name="parent_id"/><field name="cross_border"/><field name="responsible_id"/><field name="state"/></list></field></record>
<record id="processor_form" model="ir.ui.view"><field name="name">erpec.data.processor.form</field><field name="model">erpec.data.processor</field><field name="arch" type="xml"><form><sheet>
<div class="alert alert-info" role="status">Registra aquí a cada proveedor que trata datos personales por cuenta de la empresa (hosting, correo, pasarelas de pago, nube, soporte). El sistema no precarga ninguno: los declara el responsable. Un proveedor solo puede quedar Vigente con la referencia de su contrato o cláusulas de encargo.</div>
<group><group string="Proveedor"><field name="company_id"/><field name="name"/><field name="role"/><field name="parent_id" invisible="role != 'subencargado'" required="role == 'subencargado'"/><field name="responsible_id"/><field name="state"/></group>
<group string="Encargo"><field name="service"/><field name="data_categories"/><field name="activity_ids" widget="many2many_tags"/><field name="contract_reference"/><field name="security_measures"/></group></group>
<group string="Transferencia internacional"><field name="cross_border"/><field name="transfer_country" invisible="not cross_border" required="cross_border"/><field name="transfer_mechanism" invisible="not cross_border" required="cross_border"/><field name="rnpd_reference" invisible="not cross_border"/></group>
<group><field name="notes"/></group></sheet><chatter/></form></field></record>
<record id="processor_action" model="ir.actions.act_window"><field name="name">Encargados y subencargados</field><field name="res_model">erpec.data.processor</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Declara los proveedores que tratan datos por tu cuenta</p><p>Hosting, correo, pasarelas de pago o soporte que reciban datos personales. Cada uno requiere su contrato o cláusulas de encargo para quedar vigente.</p></field></record>
<menuitem id="processor_menu" name="Encargados y subencargados" parent="data_protection_menu" action="processor_action" sequence="15"/>
<record id="dpo_assessment_form" model="ir.ui.view"><field name="name">erpec.data.dpo.assessment.form</field><field name="model">erpec.data.dpo.assessment</field><field name="arch" type="xml"><form><sheet>
<div class="alert alert-info" role="status">Evalúa si el Delegado de Protección de Datos es obligatorio (Art. 49 LOPDP). Marca lo que aplica a esta empresa y motiva la conclusión: el sistema no decide por ti. Si resulta obligatorio, registra el delegado designado y su registro ante la SPDP.</div>
<group><group string="Criterios"><field name="company_id"/><field name="public_entity"/><field name="large_scale_monitoring"/><field name="large_scale_sensitive"/><field name="sector"/><field name="dpo_required"/></group>
<group string="Evaluación"><field name="assessed_by"/><field name="assessed_on"/><field name="justification"/></group></group>
<group string="Delegado designado" invisible="not dpo_required"><field name="dpo_name" required="dpo_required"/><field name="dpo_contact" required="dpo_required"/><field name="spdp_registration" required="dpo_required"/></group>
</sheet><chatter/></form></field></record>
<record id="dpo_assessment_list" model="ir.ui.view"><field name="name">erpec.data.dpo.assessment.list</field><field name="model">erpec.data.dpo.assessment</field><field name="arch" type="xml"><list><field name="company_id"/><field name="dpo_required"/><field name="assessed_by"/><field name="assessed_on"/></list></field></record>
<record id="dpo_assessment_action" model="ir.actions.act_window"><field name="name">Delegado de Protección de Datos (evaluación)</field><field name="res_model">erpec.data.dpo.assessment</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Aún no se evaluó si el DPD es obligatorio</p><p>Registra la evaluación de esta empresa con su motivación (Art. 49 LOPDP).</p></field></record>
<menuitem id="dpo_assessment_menu" name="Delegado de Protección de Datos" parent="data_protection_menu" action="dpo_assessment_action" sequence="40"/>
<record id="company_rights_channel" model="ir.ui.view"><field name="name">res.company.rights.channel</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Protección de datos"><div class="alert alert-info" role="status">El canal público de derechos del titular (página /derechos-datos del sitio) solo funciona si eliges un responsable. No se envían correos: las solicitudes quedan como tarea interna del responsable.</div><group><field name="ec_dp_public_responsible_id"/><field name="ec_dp_rights_email"/></group></page></xpath></field></record>
</odoo>
