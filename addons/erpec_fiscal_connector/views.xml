<odoo>
<record id="connection_list" model="ir.ui.view"><field name="name">erpec.fiscal.connection.list</field><field name="model">erpec.fiscal.connection</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="base_url"/><field name="verified"/><field name="checked_at"/></list></field></record>
<record id="connection_form" model="ir.ui.view"><field name="name">erpec.fiscal.connection.form</field><field name="model">erpec.fiscal.connection</field><field name="arch" type="xml"><form><header><button name="action_verify" type="object" string="Verificar conexión de pruebas" class="oe_highlight" groups="base.group_system"/></header><sheet><h1><field name="name"/></h1><div role="status" class="alert alert-info">Solo ambiente PRUEBAS. La conexión no incorpora el RUC del emisor a la empresa Odoo. No vincular la demo al emisor reservado para Founder.</div><group><field name="company_id"/><field name="base_url"/><field name="organization_ref"/><field name="empresa_ref"/><field name="workspace_ref"/><field name="emission_point_ref"/><field name="api_key" password="True" groups="base.group_system"/><field name="verified"/><field name="checked_at"/><field name="notice"/></group></sheet></form></field></record>
<record id="connection_action" model="ir.actions.act_window"><field name="name">Conexiones fiscales — Pruebas</field><field name="res_model">erpec.fiscal.connection</field><field name="view_mode">list,form</field></record>
<record id="job_list" model="ir.ui.view"><field name="name">erpec.fiscal.job.list</field><field name="model">erpec.fiscal.job</field><field name="arch" type="xml"><list create="0" delete="0"><field name="move_id"/><field name="company_id"/><field name="state"/><field name="attempts"/><field name="next_attempt"/><field name="number"/></list></field></record>
<record id="job_form" model="ir.ui.view"><field name="name">erpec.fiscal.job.form</field><field name="model">erpec.fiscal.job</field><field name="arch" type="xml"><form create="0" delete="0"><header><button name="action_process" type="object" string="Procesar / consultar" class="oe_highlight" invisible="state in ['authorized','rejected']"/><button name="action_resume" type="object" string="Habilitar nuevo ciclo" invisible="state != 'blocked'"/><field name="state" widget="statusbar"/></header><sheet><div role="status" class="alert alert-info">Bandeja persistente de PRUEBAS. Repetir una consulta conserva la referencia fiscal. La autorización solo se muestra tras comprobar la respuesta del Facturador.</div><group><field name="move_id" readonly="1"/><field name="company_id"/><field name="connection_id" readonly="1"/><field name="message"/><field name="attempts"/><field name="next_attempt"/><field name="remote_status"/><field name="remote_id"/><field name="number"/><field name="access_key"/><field name="xml_url" widget="url"/><field name="ride_url" widget="url"/></group><notebook><page string="Trazabilidad"><group><field name="external_reference"/><field name="correlation_id"/><field name="payload"/></group></page></notebook></sheet></form></field></record>
<record id="job_action" model="ir.actions.act_window"><field name="name">Bandeja fiscal — Pruebas</field><field name="res_model">erpec.fiscal.job</field><field name="view_mode">list,form</field></record>
<menuitem id="fiscal_root" name="Facturación electrónica" groups="account.group_account_user" sequence="25"/>
<menuitem id="fiscal_jobs" name="Bandeja de pruebas" parent="fiscal_root" action="job_action"/>
<menuitem id="fiscal_connections" name="Configurar conexión" parent="fiscal_root" action="connection_action" groups="base.group_system"/>
<record id="invoice_fiscal" model="ir.ui.view"><field name="name">account.move.fiscal.connector</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Facturador — Pruebas" groups="account.group_account_user" invisible="move_type != 'out_invoice'"><div role="status" class="alert alert-info">Preparar guarda la solicitud, sin emitir. Procesa después desde la bandeja fiscal. Se necesita una conexión de pruebas verificada para esta empresa.</div><group><field name="ec_fiscal_payment_code" readonly="ec_fiscal_job_ids"/><button name="action_queue_fiscal" type="object" string="Preparar / abrir envío fiscal" invisible="state != 'posted'"/></group><field name="ec_fiscal_job_ids" readonly="1"><list create="0" delete="0"><field name="external_reference"/><field name="state"/><field name="message"/></list></field></page></xpath></field></record>
<data noupdate="1"><record id="fiscal_cron" model="ir.cron"><field name="name">ERP EC: consultar bandeja fiscal de pruebas</field><field name="model_id" ref="model_erpec_fiscal_job"/><field name="state">code</field><field name="code">model._cron_process()</field><field name="interval_number">5</field><field name="interval_type">minutes</field><field name="active" eval="False"/></record></data>
</odoo>