<odoo>
<record id="group_route_manager" model="res.groups"><field name="name">Responsable de visitas ERP EC</field><field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/></record>
<record id="group_route_rep" model="res.groups"><field name="name">Vendedor — registra sus visitas</field></record>

<record id="site_company_rule" model="ir.rule"><field name="name">Sitio de visita por empresa</field><field name="model_id" ref="model_erpec_route_site"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>

<record id="day_manager_rule" model="ir.rule"><field name="name">Día de ruta — responsable ve todos en su empresa</field><field name="model_id" ref="model_erpec_route_day"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_route_manager'))]"/></record>
<record id="day_rep_rule" model="ir.rule"><field name="name">Día de ruta — vendedor ve solo el suyo</field><field name="model_id" ref="model_erpec_route_day"/><field name="domain_force">[('employee_id.user_id','=',user.id)]</field><field name="groups" eval="[(4, ref('group_route_rep'))]"/></record>

<record id="stop_manager_rule" model="ir.rule"><field name="name">Parada — responsable ve todas en su empresa</field><field name="model_id" ref="model_erpec_route_stop"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_route_manager'))]"/></record>
<record id="stop_rep_rule" model="ir.rule"><field name="name">Parada — vendedor ve solo las suyas</field><field name="model_id" ref="model_erpec_route_stop"/><field name="domain_force">[('route_day_id.employee_id.user_id','=',user.id)]</field><field name="groups" eval="[(4, ref('group_route_rep'))]"/></record>

<record id="mark_manager_rule" model="ir.rule"><field name="name">Marca de visita — responsable ve todas en su empresa</field><field name="model_id" ref="model_erpec_route_visit_mark"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_route_manager'))]"/></record>
<record id="mark_rep_rule" model="ir.rule"><field name="name">Marca de visita — vendedor ve solo las suyas</field><field name="model_id" ref="model_erpec_route_visit_mark"/><field name="domain_force">[('stop_id.route_day_id.employee_id.user_id','=',user.id)]</field><field name="groups" eval="[(4, ref('group_route_rep'))]"/></record>

<record id="exception_manager_rule" model="ir.rule"><field name="name">Excepción — responsable ve todas en su empresa</field><field name="model_id" ref="model_erpec_route_exception"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_route_manager'))]"/></record>
<record id="exception_rep_rule" model="ir.rule"><field name="name">Excepción — vendedor ve solo las suyas</field><field name="model_id" ref="model_erpec_route_exception"/><field name="domain_force">['|',('stop_id.route_day_id.employee_id.user_id','=',user.id),('mark_id.stop_id.route_day_id.employee_id.user_id','=',user.id)]</field><field name="groups" eval="[(4, ref('group_route_rep'))]"/></record>

<record id="compliance_report_rule" model="ir.rule"><field name="name">Reporte de cumplimiento por empresa</field><field name="model_id" ref="model_erpec_route_compliance_report"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_route_manager'))]"/></record>
<record id="compliance_report_line_rule" model="ir.rule"><field name="name">Línea de cumplimiento por empresa</field><field name="model_id" ref="model_erpec_route_compliance_report_line"/><field name="domain_force">[('report_id.company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_route_manager'))]"/></record>
</odoo>
