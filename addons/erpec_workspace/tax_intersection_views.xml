<odoo>
<record id="tax_intersection_purchase" model="ir.ui.view"><field name="name">purchase.order.tax.intersection</field><field name="model">purchase.order</field><field name="inherit_id" ref="purchase.purchase_order_form"/><field name="arch" type="xml"><xpath expr="//field[@name='order_line']/list/field[@name='taxes_id']" position="after"><field name="erpec_retention_ids" widget="many2many_tags" optional="show"/><field name="erpec_tax_notice" optional="hide"/></xpath></field></record>
<record id="tax_intersection_sale" model="ir.ui.view"><field name="name">sale.order.tax.intersection</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml"><xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="after"><field name="erpec_retention_ids" widget="many2many_tags" optional="show"/><field name="erpec_tax_notice" optional="hide"/></xpath></field></record>
<record id="tax_intersection_invoice" model="ir.ui.view"><field name="name">account.move.tax.intersection</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="after"><field name="erpec_retention_ids" widget="many2many_tags" optional="show"/><field name="erpec_ats_sustento_code" optional="show"/><field name="erpec_tax_notice" optional="hide"/></xpath><xpath expr="//notebook" position="inside"><page string="Retenciones del plan"><field name="erpec_retention_summary" readonly="1"/><p>Consolidación por detalle común, con las bases de cada línea. La previsión no contabiliza ni autoriza una retención.</p></page></xpath></field></record>
</odoo>
