<odoo>
  <record id="purchase_flow_form" model="ir.ui.view">
    <field name="name">purchase.order.erpec.flow</field><field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/div[hasclass('oe_title')]" position="after">
        <div class="alert alert-info py-2 px-3 mb-2" role="status" invisible="not erpec_purchase_guide">
          <field name="erpec_purchase_guide" nolabel="1"/>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
