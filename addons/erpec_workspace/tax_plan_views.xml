<odoo>
  <record id="tax_plan_company_rule" model="ir.rule">
    <field name="name">Plan de impuestos por empresa</field><field name="model_id" ref="model_erpec_tax_plan"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="tax_plan_list" model="ir.ui.view"><field name="name">erpec.tax.plan.list</field><field name="model">erpec.tax.plan</field><field name="arch" type="xml">
    <list string="Plan de impuestos"><field name="name"/><field name="operation"/><field name="product_id"/><field name="partner_id"/><field name="fiscal_position_id"/><field name="company_id" groups="base.group_multi_company"/></list>
  </field></record>
  <record id="tax_plan_form" model="ir.ui.view"><field name="name">erpec.tax.plan.form</field><field name="model">erpec.tax.plan</field><field name="arch" type="xml">
    <form string="Plan de impuestos"><header>
      <button name="action_catalog" type="object" string="Catálogo de impuestos" context="{'tax_plan_target': 'taxes'}"/>
      <button name="action_catalog" type="object" string="Plan de cuentas" context="{'tax_plan_target': 'accounts'}"/>
      <button name="action_catalog" type="object" string="Posiciones fiscales" context="{'tax_plan_target': 'positions'}"/>
    </header><sheet>
      <h1><field name="name" placeholder="Ej.: compra de artículo a proveedor"/></h1>
      <p>Consulta guardada de la configuración vigente. Modifique los impuestos en el artículo y las reglas del tercero en su posición fiscal.</p>
      <group><group><field name="company_id"/><field name="operation"/><field name="product_id"/><field name="partner_id"/></group>
        <group><field name="fiscal_position_id" options="{'no_create': True}"/><field name="source_tax_ids" widget="many2many_tags" options="{'no_create': True, 'no_edit_color': True}"/><field name="effective_tax_ids" widget="many2many_tags" options="{'no_create': True, 'no_edit_color': True}"/></group></group>
      <field name="detail" nolabel="1"/>
      <group string="Abrir cuentas vinculadas"><field name="account_ids" nolabel="1"><list create="false" edit="false" delete="false"><field name="code"/><field name="name"/><field name="account_type"/></list></field></group>
      <div class="alert alert-info" role="status">Revise el documento final: esta consulta no incluye cambios manuales del pedido o factura ni otra dirección de entrega. Un campo vacío no acredita exención. Importaciones usa los impuestos de compra; la capitalización se revisa en el expediente. Nómina y retenciones específicas mantienen sus controles propios. La validación tributaria de la empresa sigue pendiente.</div>
    </sheet></form>
  </field></record>
  <record id="tax_plan_action" model="ir.actions.act_window"><field name="name">Plan de impuestos</field><field name="res_model">erpec.tax.plan</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Cruce artículos y proveedores con sus impuestos y cuentas.</p><p>Cree un escenario para revisar la configuración nativa por operación.</p></field></record>
  <menuitem id="tax_plan_menu" name="Plan de impuestos" parent="erpec_base.suite_root" action="tax_plan_action" sequence="25" groups="account.group_account_manager"/>
  <record id="home_tax_plan" model="ir.ui.view"><field name="name">erpec.workspace.tax.plan</field><field name="model">erpec.workspace</field><field name="inherit_id" ref="home_form"/><field name="arch" type="xml">
    <xpath expr="//group[field[@name='company_readiness']]" position="before"><div class="border rounded p-3 mb-3" groups="account.group_account_manager"><h2>Plan de impuestos</h2><p>Artículos, proveedores, posiciones fiscales y cuentas contables por operación.</p><button name="action_area" type="object" string="Consultar plan de impuestos" context="{'erpec_area': 'tax_plan'}" class="btn btn-outline-primary"/></div></xpath>
  </field></record>
  <record id="account_move_manager_journal" model="ir.ui.view"><field name="name">account.move.manager.journal</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//page[@name='aml_tab']" position="attributes"><attribute name="groups">account.group_account_readonly,account.group_account_manager</attribute></xpath></field></record>
</odoo>
