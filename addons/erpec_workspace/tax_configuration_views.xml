<record id="tax_reference_action" model="ir.actions.act_window"><field name="name">1. Catálogos SRI</field><field name="res_model">erpec.tax.reference</field><field name="view_mode">list,form</field></record>
<record id="tax_classification_company_rule" model="ir.rule"><field name="name">4. Tipos de proveedores y productos por empresa</field><field name="model_id" ref="model_erpec_tax_classification"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="tax_classification_list" model="ir.ui.view"><field name="name">erpec.tax.classification.list</field><field name="model">erpec.tax.classification</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="kind"/><field name="policy_ids" widget="many2many_tags"/></list></field></record>
<record id="tax_classification_form" model="ir.ui.view"><field name="name">erpec.tax.classification.form</field><field name="model">erpec.tax.classification</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="kind"/><field name="policy_ids" widget="many2many_tags"/><field name="active"/></group><div class="alert alert-info" role="status">Los detalles comunes entre los planes del tercero y del producto se aplican automáticamente por línea en borradores. Se admiten planes distintos. Valide códigos, cuentas, vigencia y bases antes de asignarlos.</div></sheet></form></field></record>
<record id="tax_classification_action" model="ir.actions.act_window"><field name="name">4. Tipos de proveedores y productos</field><field name="res_model">erpec.tax.classification</field><field name="view_mode">list,form</field></record>
<record id="tax_policy_company_rule" model="ir.rule"><field name="name">3. Planes de impuestos por empresa</field><field name="model_id" ref="model_erpec_tax_policy"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="tax_policy_list" model="ir.ui.view"><field name="name">erpec.tax.policy.list</field><field name="model">erpec.tax.policy</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/></list></field></record>
<record id="tax_policy_form" model="ir.ui.view"><field name="name">erpec.tax.policy.form</field><field name="model">erpec.tax.policy</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="active"/><field name="note"/></group><field name="case_ids" context="{'default_policy_id': id}"><list><field name="name"/><field name="operation"/><field name="tax_ids" widget="many2many_tags"/><field name="active"/></list></field><div class="alert alert-info" role="status">Los detalles comunes entre los planes del tercero y del producto se aplican automáticamente por línea en borradores. Se admiten planes distintos. Valide códigos, cuentas, vigencia y bases antes de asignarlos.</div></sheet></form></field></record>
<record id="tax_policy_action" model="ir.actions.act_window"><field name="name">3. Planes de impuestos</field><field name="res_model">erpec.tax.policy</field><field name="view_mode">list,form</field></record>
<record id="tax_case_company_rule" model="ir.rule"><field name="name">Casos de impuestos por empresa</field><field name="model_id" ref="model_erpec_tax_case"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="tax_case_list" model="ir.ui.view"><field name="name">erpec.tax.case.list</field><field name="model">erpec.tax.case</field><field name="arch" type="xml"><list><field name="name"/><field name="policy_id"/><field name="company_id"/><field name="operation"/></list></field></record>
<record id="tax_case_form" model="ir.ui.view"><field name="name">erpec.tax.case.form</field><field name="model">erpec.tax.case</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="policy_id"/><field name="company_id"/><field name="operation"/><field name="active"/><field name="note"/><field name="withholding_bases_confirmed"/><field name="ats_sustento_code" invisible="operation not in ('purchase', 'bill', 'import')"/></group><group string="Detalles y cuentas nativas"><field name="tax_ids" widget="many2many_tags" options="{'no_create': True}"/><field name="income_withholding_ids" widget="many2many_tags" options="{'no_create': True}" domain="[('tax_group_id.l10n_ec_type', 'in', ['withhold_income_purchase', 'withhold_income_sale'])]"/><field name="vat_withholding_ids" widget="many2many_tags" options="{'no_create': True}" domain="[('tax_group_id.l10n_ec_type', 'in', ['withhold_vat_purchase', 'withhold_vat_sale'])]"/></group><p>Un plan admite varios casos y cada caso varios detalles. Las retenciones se configuran separadas del impuesto facturado; valide la base y tarifa aplicables.</p><p>Abra cada detalle desde Detalles y cuentas para configurar sus reparticiones de factura y devolución.</p><field name="mapping_ids"><list><field name="partner_type_id"/><field name="product_type_id"/><field name="operation"/></list></field><div class="alert alert-info" role="status">Los detalles comunes entre los planes del tercero y del producto se aplican automáticamente por línea en borradores. Se admiten planes distintos. Valide códigos, cuentas, vigencia y bases antes de asignarlos.</div></sheet></form></field></record>
<record id="tax_case_action" model="ir.actions.act_window"><field name="name">Casos de impuestos</field><field name="res_model">erpec.tax.case</field><field name="view_mode">list,form</field></record>
