<record id="tax_assignment_list" model="ir.ui.view"><field name="name">erpec.tax.assignment.list</field><field name="model">erpec.tax.assignment</field><field name="arch" type="xml"><list><field name="company_id"/><field name="operation"/><field name="partner_type_id"/><field name="product_type_id"/><field name="case_id"/></list></field></record>
<record id="tax_assignment_form" model="ir.ui.view"><field name="name">erpec.tax.assignment.form</field><field name="model">erpec.tax.assignment</field><field name="arch" type="xml"><form><sheet><group><field name="company_id"/><field name="operation"/><field name="partner_type_id"/><field name="product_type_id"/><field name="case_id"/></group><div class="alert alert-info" role="status">Los detalles comunes entre los planes del tercero y del producto se aplican automáticamente por línea en borradores. Se admiten planes distintos. Valide códigos, cuentas, vigencia y bases antes de asignarlos.</div></sheet></form></field></record>
<record id="tax_assignment_action" model="ir.actions.act_window"><field name="name">5. Asignaciones de planes y casos</field><field name="res_model">erpec.tax.assignment</field><field name="view_mode">list,form</field></record>
<record id="tax_detail_reference_form" model="ir.ui.view"><field name="name">account.tax.sri.reference</field><field name="model">account.tax</field><field name="inherit_id" ref="account.view_tax_form"/><field name="arch" type="xml"><xpath expr="//field[@name='tax_group_id']" position="after"><field name="erpec_reference_id" groups="account.group_account_manager"/><field name="erpec_reference_rate_description" readonly="1" groups="account.group_account_manager" invisible="not erpec_reference_id"/><field name="erpec_reference_rate_mode" readonly="1" groups="account.group_account_manager" invisible="not erpec_reference_id"/><field name="erpec_rate_status" readonly="1" groups="account.group_account_manager" invisible="not erpec_reference_id"/><field name="erpec_rate_review_note" groups="account.group_account_manager" invisible="erpec_reference_rate_mode not in ('conditional', 'unspecified')" placeholder="Condición material verificada y fuente interna de la decisión"/><button name="action_erpec_confirm_rate_review" type="object" string="Confirmar revisión de tarifa" class="oe_highlight" groups="account.group_account_manager" invisible="erpec_reference_rate_mode not in ('conditional', 'unspecified')"/><field name="erpec_rate_review_current" readonly="1" groups="account.group_account_manager" invisible="erpec_reference_rate_mode not in ('conditional', 'unspecified')"/><field name="erpec_rate_reviewed_at" readonly="1" groups="account.group_account_manager" invisible="not erpec_rate_reviewed_at"/><field name="erpec_rate_reviewed_by_id" readonly="1" groups="account.group_account_manager" invisible="not erpec_rate_reviewed_by_id"/></xpath></field></record>
<record id="tax_detail_reference_list" model="ir.ui.view"><field name="name">account.tax.sri.reference.list</field><field name="model">account.tax</field><field name="inherit_id" ref="account.view_tax_tree"/><field name="arch" type="xml"><xpath expr="//field[@name='description']" position="after"><field name="amount" string="Tarifa operativa (%)" optional="show"/><field name="erpec_reference_id" optional="show"/><field name="erpec_reference_rate_description" optional="show"/><field name="erpec_rate_status" optional="show"/></xpath></field></record>
<record id="tax_partner_type_form" model="ir.ui.view"><field name="name">res.partner.tax.type</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Planes de impuestos" groups="account.group_account_manager"><field name="erpec_tax_type_id"/><field name="erpec_policy_ids" widget="many2many_tags" options="{'no_create': True}"/><p>Se agregan los planes del tipo. La comparación se realiza por detalle y por línea; no exige planes iguales.</p><p>La resolución utiliza el tipo del tercero comercial principal en la empresa activa.</p></group></xpath></field></record>
<record id="tax_product_type_form" model="ir.ui.view"><field name="name">product.template.tax.type</field><field name="model">product.template</field><field name="inherit_id" ref="product.product_template_form_view"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Planes de impuestos" groups="account.group_account_manager"><field name="erpec_tax_type_id"/><field name="erpec_policy_ids" widget="many2many_tags" options="{'no_create': True}"/><p>Se agregan los planes del tipo. La comparación se realiza por detalle y por línea; no exige planes iguales.</p></group></xpath></field></record>
<record id="tax_scenario_case_form" model="ir.ui.view"><field name="name">erpec.tax.plan.case</field><field name="model">erpec.tax.plan</field><field name="inherit_id" ref="tax_plan_form"/><field name="arch" type="xml"><xpath expr="//field[@name='detail']" position="before"><group string="Plan y caso según los tipos"><field name="case_id"/><field name="planned_tax_ids" widget="many2many_tags"/><field name="planned_effective_tax_ids" widget="many2many_tags"/><field name="case_status"/><field name="planned_account_ids" widget="many2many_tags"/><field name="planned_income_withholding_ids" widget="many2many_tags"/><field name="planned_vat_withholding_ids" widget="many2many_tags"/><field name="withholding_account_ids" widget="many2many_tags"/></group><p>La intersección de detalles se aplica al seleccionar tercero y producto. Un cambio del catálogo no reescribe documentos confirmados. Sin planes asignados se conserva la configuración nativa.</p></xpath></field></record>
<record id="tax_plan_action" model="ir.actions.act_window"><field name="name">6. Consultar aplicación de impuestos</field></record>
