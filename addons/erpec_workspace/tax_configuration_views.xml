<record id="tax_reference_list" model="ir.ui.view"><field name="name">erpec.tax.reference.list</field><field name="model">erpec.tax.reference</field><field name="arch" type="xml"><list><field name="name"/><field name="category" optional="hide"/><field name="family" optional="hide"/><field name="code"/><field name="rate_description" optional="show"/><field name="rate_mode" optional="show"/><field name="version" optional="hide"/></list></field></record>
