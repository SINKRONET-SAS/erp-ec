<odoo>
  <record id="home_form" model="ir.ui.view">
    <field name="name">erpec.workspace.home</field><field name="model">erpec.workspace</field>
    <field name="arch" type="xml">
      <form create="false" edit="false" delete="false" duplicate="false">
        <sheet>
          <h1>Centro de trabajo</h1>
          <p class="text-muted">Elige un área para continuar. Los accesos dependen de tu perfil.</p>
          <group><field name="company_id" readonly="1" options="{'no_open': True}"/></group>
          <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6" groups="sales_team.group_sale_salesman,account.group_account_invoice"><div class="border rounded p-3 h-100">
              <h2>Ventas y cobros</h2><p>De la cotización a la factura y su cobro.</p>
              <div class="d-flex flex-wrap gap-2"><button name="action_area" type="object" string="Cotizaciones y pedidos" context="{'erpec_area': 'sales'}" groups="sales_team.group_sale_salesman" class="btn btn-outline-primary"/>
<button name="action_area" type="object" string="Facturas de clientes" context="{'erpec_area': 'invoices'}" groups="account.group_account_invoice" class="btn btn-outline-primary"/></div>
            </div></div>
            <div class="col-12 col-sm-6" groups="purchase.group_purchase_user,stock.group_stock_user,account.group_account_invoice"><div class="border rounded p-3 h-100">
              <h2>Compras y abastecimiento</h2><p>Compras, recepción de mercancía y gastos de importación.</p>
              <div class="d-flex flex-wrap gap-2"><button name="action_area" type="object" string="Solicitudes y compras" context="{'erpec_area': 'purchases'}" groups="purchase.group_purchase_user" class="btn btn-outline-primary"/>
<button name="action_area" type="object" string="Facturas de proveedores" context="{'erpec_area': 'bills'}" groups="account.group_account_invoice" class="btn btn-outline-primary"/>
<button name="action_area" type="object" string="Importaciones" context="{'erpec_area': 'imports'}" groups="stock.group_stock_user,account.group_account_manager" class="btn btn-outline-primary"/></div>
            </div></div>
            <div class="col-12 col-sm-6" groups="stock.group_stock_user,mrp.group_mrp_user"><div class="border rounded p-3 h-100">
              <h2>Inventario y producción</h2><p>Recepciones, entregas, fabricación y tiempos de trabajo.</p>
              <div class="d-flex flex-wrap gap-2"><button name="action_area" type="object" string="Operaciones de inventario" context="{'erpec_area': 'inventory'}" groups="stock.group_stock_user" class="btn btn-outline-primary"/>
<button name="action_area" type="object" string="Órdenes de fabricación" context="{'erpec_area': 'manufacturing'}" groups="mrp.group_mrp_user" class="btn btn-outline-primary"/>
<button name="action_area" type="object" string="Operaciones y tiempos" context="{'erpec_area': 'workorders'}" groups="mrp.group_mrp_user" class="btn btn-outline-primary"/></div>
            </div></div>
            <div class="col-12 col-sm-6" groups="erpec_payroll.group_payroll_manager"><div class="border rounded p-3 h-100">
              <h2>Personas y nómina</h2><p>Preparar novedades, calcular, revisar y contabilizar el período.</p>
              <div class="d-flex flex-wrap gap-2"><button name="action_area" type="object" string="Períodos y novedades" context="{'erpec_area': 'payroll'}" groups="erpec_payroll.group_payroll_manager" class="btn btn-outline-primary"/></div>
            </div></div>
          </div>
          <group string="Preparación de la empresa" groups="account.group_account_invoice,base.group_system">
            <field name="company_readiness" nolabel="1"/>
          </group>
          <div class="border rounded p-3 mb-3" groups="account.group_account_user">
            <h2>Facturación electrónica · En preparación</h2>
            <p>La preparación local permite revisar un XML sin firma. Faltan firma electrónica, envío al SRI y comprobante autorizado. Una factura contabilizada o pagada no acredita autorización fiscal.</p>
            <button name="action_area" type="object" string="Revisar preparación local" context="{'erpec_area': 'fiscal'}" class="btn btn-outline-primary"/>
          </div>
          <div class="border rounded p-3" groups="erpec_payroll.group_payroll_manager">
            <h2>Nómina · Validación pendiente</h2>
            <p>El cálculo y el asiento están disponibles en la demo. Antes de operar una empresa real se requiere completar la equivalencia laboral y el pago conciliado de la nómina.</p>
          </div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="home_window" model="ir.actions.act_window"><field name="name">Inicio · ERP EC</field><field name="res_model">erpec.workspace</field><field name="view_mode">form</field><field name="view_id" ref="home_form"/></record>
  <record id="home_action" model="ir.actions.server"><field name="name">Inicio · ERP EC</field><field name="model_id" ref="erpec_base.model_erpec_workspace"/><field name="state">code</field><field name="code">action = model.action_home()</field></record>
  <record id="erpec_base.suite_root" model="ir.ui.menu"><field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/></record>
  <record id="erpec_operations.operation_menu" model="ir.ui.menu"><field name="name">Inicio</field><field name="action" ref="home_action"/><field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/></record>
  <menuitem id="sales_menu" name="Ventas" parent="erpec_base.suite_root" action="sale.action_quotations" sequence="5" groups="sales_team.group_sale_salesman"/>
  <menuitem id="purchases_menu" name="Compras" parent="erpec_base.suite_root" action="purchase.purchase_rfq" sequence="10" groups="purchase.group_purchase_user"/>
  <menuitem id="inventory_menu" name="Inventario" parent="erpec_base.suite_root" action="stock.stock_picking_type_action" sequence="12" groups="stock.group_stock_user"/>
  <record id="erpec_imports.import_menu" model="ir.ui.menu"><field name="parent_id" ref="erpec_base.suite_root"/><field name="sequence">13</field></record>
  <record id="erpec_payroll.payroll_menu" model="ir.ui.menu"><field name="parent_id" ref="erpec_base.suite_root"/><field name="name">Nómina</field><field name="sequence">20</field></record>
  <record id="erpec_fiscal_connector.fiscal_root" model="ir.ui.menu"><field name="parent_id" ref="erpec_base.suite_root"/><field name="name">Fiscal · Pruebas</field></record>
  <record id="erpec_fiscal_connector.fiscal_connections" model="ir.ui.menu"><field name="name">Conexión externa de pruebas</field></record>
  <record id="erpec_base.suite_status" model="ir.ui.menu"><field name="name">Estado técnico</field><field name="sequence">99</field><field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/></record>
</odoo>
