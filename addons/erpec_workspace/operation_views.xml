<odoo>
<record id="imports_list" model="ir.ui.view"><field name="name">erpec.workspace.imports_list</field><field name="model">erpec.importation</field><field name="inherit_id" ref="erpec_imports.import_list"/><field name="arch" type="xml"><xpath expr="//field[@name='company_id']" position="attributes"><attribute name="string">Empresa</attribute><attribute name="optional">hide</attribute></xpath><xpath expr="//field[@name='shipment']" position="attributes"><attribute name="optional">hide</attribute></xpath></field></record>
<record id="imports_form" model="ir.ui.view"><field name="name">erpec.workspace.imports_form</field><field name="model">erpec.importation</field><field name="inherit_id" ref="erpec_imports.import_form"/><field name="arch" type="xml"><xpath expr="//field[@name='cost_ids']" position="attributes"><attribute name="readonly">True</attribute></xpath><xpath expr="//field[@name='purchase_ids']" position="attributes"><attribute name="readonly">bool(cost_ids)</attribute></xpath><xpath expr="//field[@name='partner_id']" position="attributes"><attribute name="readonly">bool(cost_ids)</attribute></xpath><xpath expr="//field[@name='currency_id']" position="attributes"><attribute name="readonly">bool(cost_ids)</attribute></xpath><xpath expr="//field[@name='company_id']" position="attributes"><attribute name="string">Empresa</attribute></xpath><xpath expr="//sheet/group" position="before"><h1>Expediente de importación</h1><p>1. Vincula las compras y recepciones. 2. Registra los gastos y sus facturas. 3. Prepara y revisa la distribución antes de validar el costo.</p></xpath></field></record>
<record id="payroll_list" model="ir.ui.view"><field name="name">erpec.workspace.payroll_list</field><field name="model">erpec.payroll.period</field><field name="inherit_id" ref="erpec_payroll.period_list"/><field name="arch" type="xml"><xpath expr="//field[@name='company_id']" position="attributes"><attribute name="string">Empresa</attribute><attribute name="optional">hide</attribute></xpath><xpath expr="//field[@name='year']" position="attributes"><attribute name="options">{'enable_formatting': False}</attribute></xpath><xpath expr="//field[@name='state']" position="attributes"><attribute name="widget">badge</attribute><attribute name="decoration-success">state == 'posted'</attribute><attribute name="decoration-info">state == 'calculated'</attribute><attribute name="decoration-muted">state == 'reversed'</attribute></xpath></field></record>
<record id="payroll_form" model="ir.ui.view"><field name="name">erpec.workspace.payroll_form</field><field name="model">erpec.payroll.period</field><field name="inherit_id" ref="erpec_payroll.period_form"/><field name="arch" type="xml"><xpath expr="//field[@name='company_id']" position="attributes"><attribute name="string">Empresa</attribute></xpath><xpath expr="//field[@name='year']" position="attributes"><attribute name="options">{'enable_formatting': False}</attribute></xpath></field></record>
<record id="policy_form" model="ir.ui.view"><field name="name">erpec.workspace.policy_form</field><field name="model">erpec.payroll.policy</field><field name="inherit_id" ref="erpec_payroll.policy_form"/><field name="arch" type="xml"><xpath expr="//field[@name='company_id']" position="attributes"><attribute name="string">Empresa</attribute></xpath><xpath expr="//field[@name='year']" position="attributes"><attribute name="options">{'enable_formatting': False}</attribute></xpath></field></record>
<record id="production_labels" model="ir.ui.view"><field name="name">erpec.workspace.production.labels</field><field name="model">mrp.production</field><field name="inherit_id" ref="mrp.mrp_production_form_view"/><field name="arch" type="xml"><xpath expr="//header/button[@name='action_start']" position="attributes"><attribute name="string">Iniciar producción</attribute></xpath><xpath expr="//page[@name='operations']/field[@name='workorder_ids']" position="before"><p>Abre una operación para registrar su motivo de pausa. Usa Iniciar / reanudar para continuar. Completa la etapa precedente antes de iniciar la siguiente. Para una fabricación parcial, revisa la cantidad producida antes de cerrar.</p></xpath></field></record>
<record id="workorder_pause_list" model="ir.ui.view"><field name="name">erpec.workspace.workorder.pause</field><field name="model">mrp.workorder</field><field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view_mo_form"/><field name="arch" type="xml"><xpath expr="//field[@name='state']" position="after"><field name="erpec_pause_reason" optional="hide" string="Motivo de pausa" readonly="state in ['done','cancel']"/></xpath><xpath expr="//button[@name='button_start']" position="attributes"><attribute name="title">Iniciar o reanudar operación</attribute><attribute name="aria-label">Iniciar o reanudar operación</attribute></xpath><xpath expr="//button[@name='button_pending']" position="attributes"><attribute name="title">Pausar con motivo</attribute><attribute name="aria-label">Pausar con motivo</attribute></xpath><xpath expr="//button[@name='button_finish']" position="attributes"><attribute name="title">Finalizar operación</attribute><attribute name="aria-label">Finalizar operación</attribute></xpath></field></record>
</odoo>
