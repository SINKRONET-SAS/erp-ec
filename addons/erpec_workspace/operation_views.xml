<odoo>
<record id="imports_list" model="ir.ui.view"><field name="name">erpec.workspace.imports_list</field><field name="model">erpec.importation</field><field name="inherit_id" ref="erpec_imports.import_list"/><field name="arch" type="xml"><xpath expr="//field[@name='company_id']" position="attributes"><attribute name="string">Empresa</attribute><attribute name="optional">hide</attribute></xpath><xpath expr="//field[@name='shipment']" position="attributes"><attribute name="optional">hide</attribute></xpath></field></record>
<record id="imports_form" model="ir.ui.view"><field name="name">erpec.workspace.imports_form</field><field name="model">erpec.importation</field><field name="inherit_id" ref="erpec_imports.import_form"/><field name="arch" type="xml"><xpath expr="//field[@name='company_id']" position="attributes"><attribute name="string">Empresa</attribute></xpath><xpath expr="//sheet/group" position="before"><h1>Expediente de importación</h1><p>1. Vincula las compras y recepciones. 2. Registra los gastos y sus facturas. 3. Prepara y revisa la distribución antes de validar el costo.</p></xpath></field></record>
<record id="payroll_list" model="ir.ui.view"><field name="name">erpec.workspace.payroll_list</field><field name="model">erpec.payroll.period</field><field name="inherit_id" ref="erpec_payroll.period_list"/><field name="arch" type="xml"><xpath expr="//field[@name='company_id']" position="attributes"><attribute name="string">Empresa</attribute><attribute name="optional">hide</attribute></xpath><xpath expr="//field[@name='year']" position="attributes"><attribute name="options">{'enable_formatting': False}</attribute></xpath><xpath expr="//field[@name='state']" position="attributes"><attribute name="widget">badge</attribute><attribute name="decoration-success">state == 'posted'</attribute><attribute name="decoration-info">state == 'calculated'</attribute><attribute name="decoration-muted">state == 'reversed'</attribute></xpath></field></record>
<record id="payroll_form" model="ir.ui.view"><field name="name">erpec.workspace.payroll_form</field><field name="model">erpec.payroll.period</field><field name="inherit_id" ref="erpec_payroll.period_form"/><field name="arch" type="xml"><xpath expr="//field[@name='company_id']" position="attributes"><attribute name="string">Empresa</attribute></xpath><xpath expr="//field[@name='year']" position="attributes"><attribute name="options">{'enable_formatting': False}</attribute></xpath></field></record>
<record id="policy_form" model="ir.ui.view"><field name="name">erpec.workspace.policy_form</field><field name="model">erpec.payroll.policy</field><field name="inherit_id" ref="erpec_payroll.policy_form"/><field name="arch" type="xml"><xpath expr="//field[@name='company_id']" position="attributes"><attribute name="string">Empresa</attribute></xpath><xpath expr="//field[@name='year']" position="attributes"><attribute name="options">{'enable_formatting': False}</attribute></xpath></field></record>
</odoo>
