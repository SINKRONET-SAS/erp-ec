<odoo>
<record id="certificate_list" model="ir.ui.view"><field name="name">erpec.fiscal.certificate.list</field><field name="model">erpec.fiscal.certificate</field><field name="arch" type="xml"><list><field name="company_id"/><field name="subject_summary"/><field name="issuer_trusted"/><field name="verified"/><field name="not_valid_after"/></list></field></record>
<record id="certificate_form" model="ir.ui.view"><field name="name">erpec.fiscal.certificate.form</field><field name="model">erpec.fiscal.certificate</field><field name="arch" type="xml"><form>
<header><button name="action_verify" type="object" string="Verificar certificado" class="oe_highlight"/><button name="action_test_signature" type="object" string="Probar firma" invisible="not verified"/></header>
<sheet>
<div class="alert alert-info" role="status">Certificado de firma electrónica para emisión nativa (firma XAdES + transmisión directa al SRI; el ambiente se configura en Ambiente SRI, por punto de emisión). Autoservicio: cada empresa carga y reemplaza su propio certificado. El archivo y su contraseña se guardan <b>cifrados</b> (AES + HMAC) con una clave que vive en el servidor y no en la base de datos: un respaldo de la base no expone el certificado, y una vez cargado no se puede volver a leer ni descargar desde aquí (para cambiarlo, súbelo de nuevo).</div>
<group><field name="company_id"/><field name="p12_loaded"/><field name="p12_fingerprint"/></group>
<group string="Cargar o reemplazar el certificado"><field name="p12_file" filename="'certificado.p12'"/><field name="p12_password" password="True"/></group>
<group string="Estado"><field name="verified"/><field name="subject_summary"/><field name="issuer_summary"/><field name="issuer_trusted"/><field name="not_valid_before"/><field name="not_valid_after"/><field name="checked_at"/><field name="signature_tested"/><field name="signature_tested_at"/><field name="notice"/></group>
</sheet></form></field></record>
<record id="certificate_action" model="ir.actions.act_window"><field name="name">Certificado de firma (SRI)</field><field name="res_model">erpec.fiscal.certificate</field><field name="view_mode">list,form</field></record>
<menuitem id="certificate_menu" name="Certificado de firma (SRI)" parent="erpec_fiscal_connector.fiscal_root" action="certificate_action" sequence="5" groups="account.group_account_user"/>

<record id="emission_list" model="ir.ui.view"><field name="name">erpec.fiscal.emission.list</field><field name="model">erpec.fiscal.emission</field><field name="arch" type="xml"><list create="0" delete="0" decoration-danger="state in ('rejected','returned','blocked')" decoration-success="state == 'authorized'"><field name="move_id"/><field name="access_key"/><field name="ambiente"/><field name="state"/><field name="attempts"/><field name="next_attempt"/><field name="queue_age_seconds"/><field name="last_error" optional="show"/></list></field></record>
<record id="emission_form" model="ir.ui.view"><field name="name">erpec.fiscal.emission.form</field><field name="model">erpec.fiscal.emission</field><field name="arch" type="xml"><form create="0" delete="0">
<header><button name="action_process" type="object" string="Procesar" class="oe_highlight" invisible="state not in ('signed','sent','waiting')"/><button name="action_review" type="object" string="Consultar estado SRI" invisible="state not in ('blocked','returned')" confirm="Se consultará la misma clave al SRI. No se modificará ni se volverá a firmar el documento."/><field name="state" widget="statusbar" statusbar_visible="draft,signed,sent,waiting,authorized"/></header>
<sheet>
<div class="alert alert-info" role="status">La autoridad es la firma nativa y el SRI directo. Revisa el ambiente indicado: una emisión en producción tiene efectos tributarios. El despacho se solicita al confirmar la transacción; una cola detenida requiere revisar el trabajador programado y la conectividad. Una demora medida no acredita cumplimiento del plazo legal.</div>
<group><field name="move_id" readonly="1"/><field name="ambiente"/><field name="access_key"/></group>
<group string="Seguimiento"><group><field name="message"/><field name="last_error"/><field name="next_attempt"/><field name="correlation_id"/></group><group><field name="authority"/><field name="queue_age_seconds"/><field name="attempts"/><field name="create_date" string="Fecha de creación"/><field name="first_attempt_at" string="Primer intento de despacho"/><field name="last_attempt_at"/><field name="dispatch_delay_seconds" invisible="not first_attempt_at"/></group></group>
<group string="Documentos"><field name="xml_unsigned" filename="'sin-firmar.xml'"/><field name="xml_signed" filename="'firmado.xml'"/><field name="xml_authorized" filename="'autorizado.xml'"/><field name="ride_pdf" filename="'RIDE.pdf'"/></group>
<group string="Autorización"><field name="authorization_number"/><field name="authorization_date"/></group>

</sheet></form></field></record>
<record id="emission_action" model="ir.actions.act_window"><field name="name">Emisiones nativas (firma + SRI)</field><field name="res_model">erpec.fiscal.emission</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">No hay emisiones que mostrar</p><p>Si aplicaste filtros, retíralos para volver a ver tus registros. Para una nueva emisión, abre la factura, nota, liquidación, retención o guía de origen. Aquí revisarás el ambiente, los tiempos y el resultado del SRI.</p></field></record>
<menuitem id="emission_menu" name="Emisiones nativas (firma + SRI)" parent="erpec_fiscal_connector.fiscal_root" action="emission_action" sequence="2"/>

<record id="invoice_native_sri" model="ir.ui.view"><field name="name">account.move.native.sri</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_native_emit" type="object" string="Firmar y transmitir al SRI" class="oe_highlight" invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/><button name="action_native_emit_liquidation" type="object" string="Firmar y transmitir liquidación de compra" class="oe_highlight" invisible="not ec_is_liquidation or state == 'cancel'" confirm="Se asignará el consecutivo del punto de emisión (si falta), se contabilizará y se firmará y transmitirá la liquidación al SRI."/></xpath><xpath expr="//div[@name='button_box']" position="inside"><button name="action_view_sri_emission" type="object" class="oe_stat_button" icon="fa-certificate" invisible="move_type not in ('out_invoice', 'out_refund') and not ec_is_liquidation"><div class="o_stat_info"><span class="o_stat_text">SRI:</span><field name="ec_sri_status" class="o_stat_value"/></div></button></xpath><xpath expr="//page[@name='erpec_documents']" position="inside"><field name="ec_is_liquidation" invisible="1"/><group string="Emisión nativa SRI" invisible="move_type not in ('out_invoice','out_refund') and not ec_is_liquidation" groups="account.group_account_user"><field name="ec_fiscal_emission_ids" nolabel="1" readonly="1"><list><field name="access_key"/><field name="ambiente"/><field name="state"/><field name="authorization_number"/><field name="authorization_date"/><field name="ride_pdf" filename="'RIDE.pdf'"/></list></field></group><group string="Sustentos de reembolso (solo si esta factura es un reembolso de gastos)" invisible="move_type != 'out_invoice'"><field name="ec_sri_reimbursement_ids" nolabel="1" readonly="ec_fiscal_emission_ids"><list editable="bottom"><field name="provider_type"/><field name="provider_vat"/><field name="provider_kind"/><field name="country_code" optional="hide"/><field name="doc_type"/><field name="doc_number"/><field name="doc_date"/><field name="authorization"/><field name="base_amount"/><field name="tax_kind"/><field name="tax_amount"/><field name="currency_id" column_invisible="True"/></list></field></group></xpath></field></record>
<record id="journal_sri_ambiente" model="ir.ui.view"><field name="name">account.journal.sri.ambiente</field><field name="model">account.journal</field><field name="inherit_id" ref="account.view_account_journal_form"/><field name="arch" type="xml"><xpath expr="//field[@name='type']" position="after"><field name="ec_point_id" invisible="type not in ('sale','general','purchase')"/><field name="ec_sri_ambiente" invisible="type not in ('sale','general','purchase')"/></xpath></field></record>
<record id="point_list" model="ir.ui.view"><field name="name">erpec.fiscal.point.list</field><field name="model">erpec.fiscal.point</field><field name="arch" type="xml"><list decoration-success="ambiente == '2'"><header><button name="action_import_from_journals" type="object" string="Importar desde diarios existentes" display="always" groups="account.group_account_manager"/></header><field name="establishment"/><field name="establishment_name"/><field name="emission"/><field name="name"/><field name="ambiente"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="point_form" model="ir.ui.view"><field name="name">erpec.fiscal.point.form</field><field name="model">erpec.fiscal.point</field><field name="arch" type="xml"><form>
<header><button name="action_create_liquidation_journal" type="object" string="Crear diario de liquidaciones de compra" invisible="not id"/><button name="action_enable_production" type="object" string="Habilitar producción" class="btn-warning" groups="account.group_account_manager" invisible="ambiente == '2' or not id" confirm="Los comprobantes de producción son documentos fiscales REALES con valor tributario y usan un consecutivo nuevo e independiente del de pruebas. Confirma que terminaste las pruebas, que el emisor está habilitado ante el SRI y que el certificado vigente corresponde a esta empresa."/><button name="action_enable_testing" type="object" string="Volver a pruebas" groups="account.group_account_manager" invisible="ambiente == '1' or not id"/><field name="ambiente" widget="statusbar"/></header>
<sheet>
<div class="alert alert-info" role="status">El establecimiento corresponde a un local o sucursal registrado en el RUC; cada punto de emisión es una caja o punto de venta dentro de él. El SRI numera cada combinación (establecimiento, punto de emisión, tipo de comprobante) de forma independiente en pruebas y en producción: aquí se mantiene un diario de ventas por ambiente, cada uno con su propio consecutivo.</div>
<group><group string="Establecimiento"><field name="company_id"/><field name="establishment_id" required="1" context="{'default_company_id': company_id}"/><field name="establishment" string="Código"/><field name="establishment_address"/></group><group string="Punto de emisión"><field name="emission"/><field name="name"/><field name="active"/></group></group>
<group string="Ambiente SRI">
<field name="ambiente" string="Ambiente actual" widget="radio" options="{'horizontal': True}" readonly="1"/>
<div class="text-muted" colspan="2">1 · Pruebas: comprobantes sin validez tributaria. 2 · Producción: los comprobantes autorizados por el SRI tienen validez tributaria. Guarda el punto y usa Habilitar producción o Volver a pruebas. Solo el responsable contable puede cambiar el ambiente; se conserva la numeración de cada ambiente.</div>
<field name="production_acknowledged"/><field name="production_by"/><field name="production_at"/><field name="notice"/></group>
<group string="Diarios y consecutivos"><field name="journal_ids" nolabel="1" readonly="1"><list><field name="name"/><field name="code"/><field name="ec_sri_ambiente"/><field name="active"/></list></field></group>
</sheet></form></field></record>
<record id="point_action" model="ir.actions.act_window"><field name="name">Ambiente SRI · Puntos de emisión</field><field name="res_model">erpec.fiscal.point</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Registra tus establecimientos y puntos de emisión</p><p>Un establecimiento es un local o sucursal registrado en tu RUC y cada punto de emisión es una caja o punto de venta dentro de él. Indica el código de 3 dígitos, el nombre y la dirección del establecimiento; el sistema crea el diario de ventas con su propio consecutivo para pruebas y para producción. Puedes crear todos los que necesites.</p></field></record>
<menuitem id="point_menu" name="Ambiente SRI" parent="erpec_fiscal_connector.fiscal_root" action="point_action" sequence="0" groups="account.group_account_user"/>
<record id="user_allowed_points" model="ir.ui.view"><field name="name">res.users.allowed.points</field><field name="model">res.users</field><field name="inherit_id" ref="base.view_users_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Facturación electrónica" name="erpec_points"><group><field name="ec_allowed_point_ids" widget="many2many_tags"/><field name="ec_point_id"/></group><p class="text-muted">Si eliges puntos permitidos, este usuario solo podrá contabilizar y emitir comprobantes de venta con ellos.</p></page></xpath></field></record>
<record id="user_point_preference" model="ir.ui.view"><field name="name">res.users.point.preference</field><field name="model">res.users</field><field name="inherit_id" ref="base.view_users_form_simple_modif"/><field name="arch" type="xml"><xpath expr="//group[@name='preferences']" position="after"><group name="fiscal_point" string="Facturación electrónica"><field name="ec_point_id" readonly="0"/></group></xpath></field></record>
<record id="establishment_list" model="ir.ui.view"><field name="name">erpec.fiscal.establishment.list</field><field name="model">erpec.fiscal.establishment</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="address"/><field name="is_principal"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="establishment_form" model="ir.ui.view"><field name="name">erpec.fiscal.establishment.form</field><field name="model">erpec.fiscal.establishment</field><field name="arch" type="xml"><form><sheet>
<div class="alert alert-info" role="status">El establecimiento es el local o sucursal registrado en tu RUC. Registra aquí su código, nombre y dirección una sola vez; luego crea sus puntos de emisión (cajas). Puedes crear todos los establecimientos que necesites.</div>
<group><group><field name="company_id"/><field name="code"/><field name="name"/><field name="address"/></group><group><field name="is_principal"/><field name="active"/></group></group>
<group string="Puntos de emisión de este establecimiento"><field name="point_ids" nolabel="1"><list><field name="emission"/><field name="name"/><field name="ambiente"/></list></field></group>
</sheet></form></field></record>
<record id="establishment_action" model="ir.actions.act_window"><field name="name">Establecimientos</field><field name="res_model">erpec.fiscal.establishment</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Registra tus establecimientos</p><p>Cada local o sucursal registrado en tu RUC es un establecimiento, con su código de 3 dígitos, nombre y dirección.</p></field></record>
<menuitem id="establishment_menu" name="Establecimientos" parent="erpec_fiscal_connector.fiscal_root" action="establishment_action" sequence="3" groups="account.group_account_user"/>
</odoo>
