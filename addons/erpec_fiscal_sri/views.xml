<odoo>
<record id="certificate_list" model="ir.ui.view"><field name="name">erpec.fiscal.certificate.list</field><field name="model">erpec.fiscal.certificate</field><field name="arch" type="xml"><list><field name="company_id"/><field name="subject_summary"/><field name="issuer_trusted"/><field name="verified"/><field name="not_valid_after"/></list></field></record>
<record id="certificate_form" model="ir.ui.view"><field name="name">erpec.fiscal.certificate.form</field><field name="model">erpec.fiscal.certificate</field><field name="arch" type="xml"><form>
<header><button name="action_verify" type="object" string="Verificar certificado" class="oe_highlight"/><button name="action_test_signature" type="object" string="Probar firma" invisible="not verified"/></header>
<sheet>
<div class="alert alert-info" role="status">Certificado de firma electrónica para emisión nativa (firma XAdES + transmisión SOAP directa al SRI, ambiente PRUEBAS). Autoservicio: cada empresa carga y reemplaza su propio certificado. El archivo y la contraseña se guardan sin cifrado adicional en reposo, protegidos solo por permisos de la empresa — igual que la credencial de PayPhone.</div>
<group><field name="company_id"/><field name="p12_file" filename="'certificado.p12'"/><field name="p12_password" password="True"/></group>
<group string="Estado"><field name="verified"/><field name="subject_summary"/><field name="issuer_summary"/><field name="issuer_trusted"/><field name="not_valid_before"/><field name="not_valid_after"/><field name="checked_at"/><field name="signature_tested"/><field name="signature_tested_at"/><field name="notice"/></group>
</sheet></form></field></record>
<record id="certificate_action" model="ir.actions.act_window"><field name="name">Certificado de firma (SRI)</field><field name="res_model">erpec.fiscal.certificate</field><field name="view_mode">list,form</field></record>
<menuitem id="certificate_menu" name="Certificado de firma (SRI)" parent="erpec_fiscal_connector.fiscal_root" action="certificate_action" sequence="5" groups="account.group_account_user"/>

<record id="emission_list" model="ir.ui.view"><field name="name">erpec.fiscal.emission.list</field><field name="model">erpec.fiscal.emission</field><field name="arch" type="xml"><list decoration-danger="state in ('rejected','returned','blocked')" decoration-success="state == 'authorized'"><field name="move_id"/><field name="access_key"/><field name="ambiente"/><field name="state"/><field name="attempts"/></list></field></record>
<record id="emission_form" model="ir.ui.view"><field name="name">erpec.fiscal.emission.form</field><field name="model">erpec.fiscal.emission</field><field name="arch" type="xml"><form>
<header><button name="action_process" type="object" string="Procesar" class="oe_highlight" invisible="state in ('authorized','rejected')"/><field name="state" widget="statusbar" statusbar_visible="draft,signed,sent,waiting,authorized"/></header>
<sheet>
<div class="alert alert-info" role="status">Emisión nativa: firma propia y transmisión SOAP directa al SRI, sin depender de un servicio externo. Ambiente PRUEBAS únicamente en este incremento.</div>
<group><field name="move_id"/><field name="ambiente"/><field name="access_key"/></group>
<group string="Documentos"><field name="xml_unsigned" filename="'sin-firmar.xml'"/><field name="xml_signed" filename="'firmado.xml'"/><field name="xml_authorized" filename="'autorizado.xml'"/><field name="ride_pdf" filename="'RIDE.pdf'"/></group>
<group string="Autorización"><field name="authorization_number"/><field name="authorization_date"/></group>
<group string="Seguimiento"><field name="attempts"/><field name="next_attempt"/><field name="message"/></group>
</sheet></form></field></record>
<record id="emission_action" model="ir.actions.act_window"><field name="name">Emisiones nativas (firma + SRI)</field><field name="res_model">erpec.fiscal.emission</field><field name="view_mode">list,form</field></record>
<menuitem id="emission_menu" name="Emisiones nativas (firma + SRI)" parent="erpec_fiscal_connector.fiscal_root" action="emission_action" sequence="2"/>

<record id="invoice_native_sri" model="ir.ui.view"><field name="name">account.move.native.sri</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Firma y transmisión SRI" invisible="move_type not in ('out_invoice','out_refund') and not ec_is_liquidation" groups="account.group_account_user"><div class="alert alert-warning" role="status">Emite con firma real y la transmite directamente al SRI en el ambiente del punto de emisión del diario (pruebas o producción). Requiere un certificado de firma verificado en esta empresa. Para notas de crédito o débito, genera primero el comprobante desde "Añadir nota de crédito/débito" sobre la factura original. La liquidación de compra se emite desde una factura de proveedor con tipo documental Liquidación de compra (03). Solo una vía (vista previa, Facturador externo o esta) puede tener autoridad sobre un comprobante.</div><field name="ec_is_liquidation" invisible="1"/><group string="Sustentos de reembolso (solo si esta factura es un reembolso de gastos)" invisible="move_type != 'out_invoice'"><field name="ec_sri_reimbursement_ids" nolabel="1" readonly="ec_fiscal_emission_ids"><list editable="bottom"><field name="provider_type"/><field name="provider_vat"/><field name="provider_kind"/><field name="country_code" optional="hide"/><field name="doc_type"/><field name="doc_number"/><field name="doc_date"/><field name="authorization"/><field name="base_amount"/><field name="tax_kind"/><field name="tax_amount"/><field name="currency_id" column_invisible="True"/></list></field></group><group><button name="action_native_emit" type="object" string="Firmar y transmitir al SRI" class="oe_highlight" invisible="state != 'posted' or move_type == 'in_invoice'"/><button name="action_native_emit_liquidation" type="object" string="Firmar y transmitir liquidación de compra" class="oe_highlight" invisible="not ec_is_liquidation or state == 'cancel'" confirm="Se asignará el consecutivo del punto de emisión (si falta), se contabilizará y se firmará y transmitirá la liquidación al SRI."/><field name="ec_fiscal_emission_ids"/></group></page></xpath></field></record>
<record id="journal_sri_ambiente" model="ir.ui.view"><field name="name">account.journal.sri.ambiente</field><field name="model">account.journal</field><field name="inherit_id" ref="account.view_account_journal_form"/><field name="arch" type="xml"><xpath expr="//field[@name='type']" position="after"><field name="ec_point_id" invisible="type not in ('sale','general','purchase')"/><field name="ec_sri_ambiente" invisible="type not in ('sale','general','purchase')"/></xpath></field></record>
<record id="point_list" model="ir.ui.view"><field name="name">erpec.fiscal.point.list</field><field name="model">erpec.fiscal.point</field><field name="arch" type="xml"><list decoration-success="ambiente == '2'"><header><button name="action_import_from_journals" type="object" string="Importar desde diarios existentes" display="always" groups="account.group_account_manager"/></header><field name="establishment"/><field name="establishment_name"/><field name="emission"/><field name="name"/><field name="ambiente"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="point_form" model="ir.ui.view"><field name="name">erpec.fiscal.point.form</field><field name="model">erpec.fiscal.point</field><field name="arch" type="xml"><form>
<header><button name="action_create_liquidation_journal" type="object" string="Crear diario de liquidaciones de compra" invisible="not id"/><button name="action_enable_production" type="object" string="Habilitar producción" class="btn-warning" invisible="ambiente == '2' or not id" confirm="Los comprobantes de producción son documentos fiscales REALES con valor tributario y usan un consecutivo nuevo e independiente del de pruebas. Confirma que el certificado de firma es el de producción y que el establecimiento y punto de emisión están registrados en el SRI."/><button name="action_enable_testing" type="object" string="Volver a pruebas" invisible="ambiente == '1' or not id"/><field name="ambiente" widget="statusbar"/></header>
<sheet>
<div class="alert alert-info" role="status">El establecimiento corresponde a un local o sucursal registrado en el RUC; cada punto de emisión es una caja o punto de venta dentro de él. El SRI numera cada combinación (establecimiento, punto de emisión, tipo de comprobante) de forma independiente en pruebas y en producción: aquí se mantiene un diario de ventas por ambiente, cada uno con su propio consecutivo.</div>
<group><group string="Establecimiento"><field name="company_id"/><field name="establishment_id" required="1" context="{'default_company_id': company_id}"/><field name="establishment" string="Código"/><field name="establishment_address"/></group><group string="Punto de emisión"><field name="emission"/><field name="name"/><field name="active"/></group></group>
<group string="Ambiente" invisible="not id"><field name="production_acknowledged"/><field name="production_by"/><field name="production_at"/><field name="notice"/></group>
<group string="Diarios y consecutivos"><field name="journal_ids" nolabel="1" readonly="1"><list><field name="name"/><field name="code"/><field name="ec_sri_ambiente"/><field name="active"/></list></field></group>
</sheet></form></field></record>
<record id="point_action" model="ir.actions.act_window"><field name="name">Establecimientos y puntos de emisión</field><field name="res_model">erpec.fiscal.point</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Registra tus establecimientos y puntos de emisión</p><p>Un establecimiento es un local o sucursal registrado en tu RUC y cada punto de emisión es una caja o punto de venta dentro de él. Indica el código de 3 dígitos, el nombre y la dirección del establecimiento; el sistema crea el diario de ventas con su propio consecutivo para pruebas y para producción. Puedes crear todos los que necesites.</p></field></record>
<menuitem id="point_menu" name="Establecimientos y puntos de emisión" parent="erpec_fiscal_connector.fiscal_root" action="point_action" sequence="4" groups="account.group_account_user"/>
<record id="user_point_preference" model="ir.ui.view"><field name="name">res.users.point.preference</field><field name="model">res.users</field><field name="inherit_id" ref="base.view_users_form_simple_modif"/><field name="arch" type="xml"><xpath expr="//group[@name='preferences']" position="after"><group name="fiscal_point" string="Facturación electrónica"><field name="ec_point_id" readonly="0"/></group></xpath></field></record>
<record id="establishment_list" model="ir.ui.view"><field name="name">erpec.fiscal.establishment.list</field><field name="model">erpec.fiscal.establishment</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="address"/><field name="is_principal"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="establishment_form" model="ir.ui.view"><field name="name">erpec.fiscal.establishment.form</field><field name="model">erpec.fiscal.establishment</field><field name="arch" type="xml"><form><sheet>
<div class="alert alert-info" role="status">El establecimiento es el local o sucursal registrado en tu RUC. Registra aquí su código, nombre y dirección una sola vez; luego crea sus puntos de emisión (cajas). Puedes crear todos los establecimientos que necesites.</div>
<group><group><field name="company_id"/><field name="code"/><field name="name"/><field name="address"/></group><group><field name="is_principal"/><field name="active"/></group></group>
<group string="Puntos de emisión de este establecimiento"><field name="point_ids" nolabel="1"><list><field name="emission"/><field name="name"/><field name="ambiente"/></list></field></group>
</sheet></form></field></record>
<record id="establishment_action" model="ir.actions.act_window"><field name="name">Establecimientos</field><field name="res_model">erpec.fiscal.establishment</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Registra tus establecimientos</p><p>Cada local o sucursal registrado en tu RUC es un establecimiento, con su código de 3 dígitos, nombre y dirección.</p></field></record>
<menuitem id="establishment_menu" name="Establecimientos" parent="erpec_fiscal_connector.fiscal_root" action="establishment_action" sequence="3" groups="account.group_account_user"/>
</odoo>
