<odoo>
<record id="withholding_sri_form" model="ir.ui.view"><field name="name">erpec.withholding.sri</field><field name="model">erpec.withholding</field><field name="inherit_id" ref="erpec_withholding_accounting.retention_form"/><field name="arch" type="xml">
<xpath expr="//button[@name='action_open_entry']" position="after"><button name="action_sri_emit" type="object" string="Firmar y emitir al SRI" class="oe_highlight" invisible="state != 'posted' or direction != 'issued'" confirm="Se firmará la retención con el certificado de la empresa y se transmitirá al SRI."/><button name="action_print_ride" type="object" string="Imprimir RIDE" class="btn-secondary" invisible="not sri_number"/></xpath>
<xpath expr="//p" position="before"><group string="Comprobante electrónico SRI (retención a proveedor)" invisible="direction != 'issued'"><group><field name="sri_number"/><field name="sri_sustento_code" readonly="state == 'reversed'"/><field name="sri_related_party" readonly="sri_number"/></group><group><field name="sri_payment_code" readonly="sri_number"/><field name="sri_support_authorization" readonly="sri_number"/></group></group><group string="Emisión electrónica SRI" invisible="direction != 'issued'"><field name="emission_ids" readonly="1" nolabel="1"><list><field name="access_key"/><field name="ambiente"/><field name="state"/><field name="authorization_number"/><field name="authorization_date"/><field name="ride_pdf" filename="'RIDE.pdf'"/></list></field></group></xpath>
<xpath expr="//field[@name='line_ids']/list/field[@name='name']" position="after"><field name="sri_code"/><field name="sri_code_label" optional="show"/></xpath>
</field></record>
<record id="invoice_withholding_smart_button" model="ir.ui.view"><field name="name">account.move.withholding.smart.button</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside"><button name="action_view_withholdings" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="move_type not in ('in_invoice', 'in_refund') or ec_withholding_count == 0"><field name="ec_withholding_count" widget="statinfo" string="Retención SRI"/></button></xpath></field></record>
<record id="emission_withholding_form" model="ir.ui.view"><field name="name">erpec.fiscal.emission.withholding</field><field name="model">erpec.fiscal.emission</field><field name="inherit_id" ref="erpec_fiscal_sri.emission_form"/><field name="arch" type="xml"><xpath expr="//field[@name='move_id']" position="after"><field name="withholding_id"/></xpath></field></record>
<record id="company_withholding_sri" model="ir.ui.view"><field name="name">res.company.withholding.sri</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//field[@name='vat']" position="after"><field name="ec_withholding_entity"/><field name="ec_withholding_emission"/><field name="ec_agent_resolution"/></xpath></field></record>
</odoo>
