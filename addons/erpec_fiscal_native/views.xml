<odoo>
<record id="preview_form" model="ir.ui.view"><field name="name">erpec.fiscal.preview.form</field><field name="model">erpec.fiscal.preview</field><field name="arch" type="xml"><form create="0" edit="0"><sheet><div class="alert alert-warning">VISTA PREVIA SIN FIRMA. No es un comprobante autorizado ni se ha enviado al SRI. No reserva otro secuencial. El XML pasa el esquema estructural de factura 2.1.0; esto no acredita validación tributaria.</div><group><field name="move_id"/><field name="access_key"/><field name="filename" invisible="1"/><field name="xml_file" filename="filename"/><field name="digest"/></group></sheet><footer><button string="Cerrar" special="cancel"/></footer></form></field></record>
<record id="invoice_native" model="ir.ui.view"><field name="name">account.move.native.fiscal</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Facturación local" invisible="move_type != 'out_invoice'" groups="account.group_account_user"><field name="ec_native_notice" nolabel="1"/><group><field name="ec_fiscal_payment_code"/><button name="action_native_preview" type="object" string="Validar y descargar XML previo" invisible="state != 'posted'"/></group></page></xpath></field></record>
<record id="native_action" model="ir.actions.act_window"><field name="name">Facturas — preparación local</field><field name="res_model">account.move</field><field name="view_mode">list,form</field><field name="domain">[('move_type','=','out_invoice')]</field><field name="context">{'default_move_type':'out_invoice'}</field></record>
<menuitem id="native_invoices" name="Facturas — preparación local" parent="erpec_fiscal_connector.fiscal_root" action="native_action" sequence="1"/>
<record id="company_native" model="ir.ui.view"><field name="name">res.company.native.fiscal</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Facturación local"><div class="alert alert-info">Completar según RUC real. Este perfil no incluye RIMPE, contribuyente especial, agente de retención, exportación ni transporte. La demo sin RUC conserva estos campos sin confirmar.</div><group><field name="ec_native_ordinary"/><field name="ec_native_accounting"/></group></page></xpath></field></record></odoo>
