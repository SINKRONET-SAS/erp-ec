<odoo>
  <record id="workspace_company_rule" model="ir.rule"><field name="name">ERP EC por compañía</field><field name="model_id" ref="model_erpec_workspace"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="workspace_list" model="ir.ui.view"><field name="name">erpec.workspace.list</field><field name="model">erpec.workspace</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="platform"/><field name="integration_status"/></list></field></record>
  <record id="workspace_form" model="ir.ui.view"><field name="name">erpec.workspace.form</field><field name="model">erpec.workspace</field><field name="arch" type="xml"><form><sheet><h1><field name="name"/></h1><group><field name="company_id"/><field name="platform"/><field name="integration_status"/><field name="next_action"/></group></sheet></form></field></record>
  <record id="workspace_action" model="ir.actions.act_window"><field name="name">Estado de la suite</field><field name="res_model">erpec.workspace</field><field name="view_mode">list,form</field></record>
  <menuitem id="suite_root" name="ERP EC" sequence="1" groups="base.group_system"/>
  <menuitem id="suite_status" name="Estado de la suite" parent="suite_root" action="workspace_action" sequence="1"/>
</odoo>
