<odoo>
<record id="provision_company_rule" model="ir.rule"><field name="name">Instancias por organización</field><field name="model_id" ref="model_erpec_provision"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="subscription_provision_form" model="ir.ui.view"><field name="name">Contrato aprovisionamiento</field><field name="model">erpec.subscription</field><field name="inherit_id" ref="erpec_suite.subscription_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_provision" type="object" string="Preparar instancia" invisible="state != 'active'"/></xpath></field></record>
<record id="provision_list" model="ir.ui.view"><field name="name">erpec.provision.list</field><field name="model">erpec.provision</field><field name="arch" type="xml"><list create="0"><field name="company_id"/><field name="customer_id"/><field name="state"/><field name="attempts"/><field name="endpoint" widget="url"/><field name="last_error"/></list></field></record>
<record id="provision_form" model="ir.ui.view"><field name="name">erpec.provision.form</field><field name="model">erpec.provision</field><field name="arch" type="xml"><form create="0"><header><button name="action_retry" type="object" string="Reintentar tras revisar el fallo" invisible="state != 'failed'"/><button name="action_refresh_access" type="object" string="Renovar enlace de acceso" invisible="state != 'ready' or not customer_id"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="customer_id"/><field name="subscription_id"/><field name="endpoint" widget="url"/><field name="attempts"/><field name="lease_until"/><field name="last_error"/><field name="observed_users"/><field name="applied_revision"/><field name="activation_expires"/><field name="next_action"/></group></sheet></form></field></record>
<record id="provision_action" model="ir.actions.act_window"><field name="name">Instancias y trabajos</field><field name="res_model">erpec.provision</field><field name="view_mode">list,form</field></record>
<menuitem id="provision_menu" name="Instancias y trabajos" parent="erpec_base.suite_root" action="provision_action" sequence="40"/>
</odoo>
