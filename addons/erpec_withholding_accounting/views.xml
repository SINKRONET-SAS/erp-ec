<odoo>
<record id="retention_form" model="ir.ui.view"><field name="name">erpec.withholding.form</field><field name="model">erpec.withholding</field><field name="arch" type="xml"><form>
<header><button name="action_post" type="object" string="Contabilizar y conciliar" class="oe_highlight" invisible="state != 'draft'"/><button name="action_reverse" type="object" string="Revertir asiento" invisible="state != 'posted'" confirm="Se generará un asiento inverso y se devolverá a la factura el importe de esta retención. Esto no anula el comprobante en el SRI."/><button name="action_open_entry" type="object" string="Ver asiento" invisible="not entry_id"/><field name="state" widget="statusbar"/></header>
<sheet><div class="alert alert-warning" role="status"><field name="fiscal_notice" nolabel="1"/></div>
<group><group><field name="reference" readonly="state != 'draft'"/><field name="invoice_id" domain="[('move_type','in',['in_invoice','out_invoice']),('state','=','posted')]" readonly="state != 'draft'"/><field name="direction"/><field name="partner_id"/><field name="company_id"/><field name="currency_id"/></group><group><field name="date" readonly="state != 'draft'"/><field name="journal_id" domain="[('type','=','general'),('company_id','=',company_id)]" readonly="state != 'draft'"/><field name="entry_id"/><field name="reversal_id"/><field name="correlation_id"/></group></group>
<p>Indica la base y el porcentaje verificado de cada concepto. Revisa las cuentas tributarias antes de contabilizar.</p>
<field name="line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="company_id" column_invisible="True"/><field name="currency_id" column_invisible="True"/><field name="name"/><field name="kind"/><field name="base"/><field name="rate"/><field name="amount"/><field name="account_id"/></list></field><group><field name="amount"/></group>
<group string="Reversión contable" invisible="state == 'draft'"><field name="reversal_date" readonly="state == 'reversed'"/><field name="reversal_reason" readonly="state == 'reversed'"/></group></sheet><chatter/></form></field></record>
<record id="retention_list" model="ir.ui.view"><field name="name">erpec.withholding.list</field><field name="model">erpec.withholding</field><field name="arch" type="xml"><list><field name="reference"/><field name="invoice_id"/><field name="direction"/><field name="partner_id"/><field name="date"/><field name="amount"/><field name="currency_id" column_invisible="True"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="retention_search" model="ir.ui.view"><field name="name">erpec.withholding.search</field><field name="model">erpec.withholding</field><field name="arch" type="xml"><search><field name="reference"/><field name="invoice_id"/><field name="partner_id"/><field name="state"/></search></field></record>
<record id="retention_action" model="ir.actions.act_window"><field name="name">Retenciones contables</field><field name="res_model">erpec.withholding</field><field name="view_mode">list,form</field></record>
<!-- DI26-F.2: las retenciones contables tienen una sola entrada, en "Contabilidad ERP EC > Retenciones" (accounting.xml). -->
<record id="invoice_retention_view" model="ir.ui.view"><field name="name">account.move.retenciones.contables</field><field name="model">account.move</field><field name="inherit_id" ref="erpec_fiscal_documents.move_ec_documents"/><field name="arch" type="xml"><xpath expr="//page[@name='erpec_documents']" position="inside"><group string="Retenciones con efecto contable" groups="account.group_account_user" invisible="move_type not in ('in_invoice','out_invoice')"><button name="%(retention_action)d" type="action" string="Gestionar retenciones" context="{'default_invoice_id': id, 'search_default_invoice_id': id}"/><field name="ec_accounting_withholding_ids" readonly="1"><list><field name="reference"/><field name="amount"/><field name="currency_id" column_invisible="True"/><field name="state"/><field name="entry_id"/></list></field></group></xpath></field></record>
<record id="reimbursement_accounting_view" model="ir.ui.view"><field name="name">account.move.reembolso.contable</field><field name="model">account.move</field><field name="inherit_id" ref="erpec_fiscal_documents.move_ec_documents"/><field name="arch" type="xml"><xpath expr="//field[@name='ec_reimbursement_ids']/list/field[@name='supplier_id']" position="before"><field name="invoice_line_id" domain="[('move_id','=',parent.id),('display_type','=','product')]"/></xpath><xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after"><field name="ec_reimbursement" optional="hide"/></xpath></field></record>
</odoo>
