<odoo>
<record id="asset_list" model="ir.ui.view"><field name="name">erpec.asset.list</field><field name="model">erpec.asset</field><field name="arch" type="xml"><list><field name="name"/><field name="category_id"/><field name="company_id"/><field name="acquisition_date"/><field name="cost"/><field name="accumulated"/><field name="book_value"/><field name="state"/></list></field></record>
<record id="asset_form" model="ir.ui.view"><field name="name">erpec.asset.form</field><field name="model">erpec.asset</field><field name="arch" type="xml"><form><header><button name="action_confirm" type="object" string="Confirmar alta" class="btn-primary" invisible="state != 'draft'" groups="account.group_account_manager"/><button name="action_depreciate" type="object" string="Contabilizar cuotas vencidas" invisible="state != 'running'" groups="account.group_account_manager"/><button name="action_open_adjustment" type="object" string="Cambiar estimación" invisible="state != 'running'" groups="account.group_account_manager"/><button name="action_open_disposal" type="object" string="Baja o venta" invisible="state != 'running'" groups="account.group_account_manager"/><button name="action_open_reversal" type="object" string="Revertir" invisible="state not in ['running','disposed']" groups="account.group_account_manager"/><field name="state" widget="statusbar"/></header><sheet><h1><field name="name"/></h1><group><group><field name="company_id" readonly="state != 'draft'"/><field name="category_id" readonly="state != 'draft'"/><field name="source_line_id" readonly="state != 'draft'" domain="[('company_id','=',company_id),('move_id.state','=','posted'),('move_id.move_type','=','in_invoice'),('display_type','=','product')]"/><field name="acquisition_date" readonly="state != 'draft'"/><field name="service_date" readonly="state != 'draft'"/></group><group><field name="currency_id" invisible="1"/><field name="cost" readonly="state != 'draft'"/><field name="residual" readonly="state != 'draft'"/><field name="months" readonly="state != 'draft'"/><field name="accumulated"/><field name="book_value"/><field name="disposal_date"/><field name="sale_line_id"/></group></group><notebook><page string="Depreciación"><field name="line_ids" readonly="1"><list><field name="date"/><field name="amount"/><field name="move_id"/><field name="reversal_id"/></list></field></page><page string="Asientos"><field name="move_ids" readonly="1"><list><field name="date"/><field name="name"/><field name="erpec_asset_kind"/><field name="state"/></list></field></page><page string="Estimaciones"><field name="revision_ids" readonly="1"/></page><page string="Notas"><field name="notes"/></page></notebook></sheet></form></field></record>
<record id="asset_search" model="ir.ui.view"><field name="name">erpec.asset.search</field><field name="model">erpec.asset</field><field name="arch" type="xml"><search><field name="name"/><field name="category_id"/><filter name="running" string="En uso" domain="[('state','=','running')]"/><group expand="0" string="Agrupar"><filter name="company" string="Empresa" context="{'group_by':'company_id'}"/><filter name="category" string="Categoría" context="{'group_by':'category_id'}"/></group></search></field></record>
<record id="asset_pivot" model="ir.ui.view"><field name="name">erpec.asset.pivot</field><field name="model">erpec.asset</field><field name="arch" type="xml"><pivot string="Conciliación de activos"><field name="company_id" type="row"/><field name="category_id" type="row"/><field name="ledger_cost" type="measure"/><field name="ledger_accumulated" type="measure"/><field name="book_value" type="measure"/></pivot></field></record>
<record id="asset_action" model="ir.actions.act_window"><field name="name">Activos fijos</field><field name="res_model">erpec.asset</field><field name="view_mode">list,form,pivot</field></record>
<record id="category_form" model="ir.ui.view"><field name="name">erpec.asset.category.form</field><field name="model">erpec.asset.category</field><field name="arch" type="xml"><form><sheet><h1><field name="name"/></h1><group><field name="company_id"/><field name="journal_id"/><field name="months"/></group><group string="Cuentas contables"><field name="asset_account_id"/><field name="accumulated_account_id"/><field name="expense_account_id"/><field name="clearing_account_id"/><field name="loss_account_id"/><field name="gain_account_id"/></group></sheet></form></field></record>
<record id="category_action" model="ir.actions.act_window"><field name="name">Categorías de activos</field><field name="res_model">erpec.asset.category</field><field name="view_mode">list,form</field></record>
<menuitem id="asset_root" name="Activos fijos" parent="account.menu_finance" sequence="45" groups="account.group_account_readonly"/>
<menuitem id="asset_menu" name="Activos y depreciación" parent="asset_root" action="asset_action"/>
<menuitem id="category_menu" name="Categorías" parent="asset_root" action="category_action" groups="account.group_account_manager"/>
<record id="asset_purchase_line_action" model="ir.actions.server"><field name="name">Crear activo fijo</field><field name="model_id" ref="account.model_account_move_line"/><field name="binding_model_id" ref="account.model_account_move_line"/><field name="state">code</field><field name="code">action = records.action_create_erpec_asset()</field><field name="groups_id" eval="[(4,ref('account.group_account_manager'))]"/></record>
<record id="bill_asset_button" model="ir.ui.view"><field name="name">Capitalizar línea de compra</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//field[@name='invoice_line_ids']/list" position="inside"><button name="action_create_erpec_asset" type="object" string="Activo fijo" icon="fa-building" invisible="parent.state != 'posted' or parent.move_type != 'in_invoice' or display_type != 'product'" groups="account.group_account_manager"/></xpath></field></record>
<record id="adjustment_form" model="ir.ui.view"><field name="name">Cambio de estimación</field><field name="model">erpec.asset.adjustment</field><field name="arch" type="xml"><form><group><field name="asset_id"/><field name="effective_date"/><field name="months"/><field name="residual"/><field name="reason"/></group><footer><button name="action_apply" type="object" string="Aplicar a periodos futuros" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="disposal_form" model="ir.ui.view"><field name="name">Baja o venta</field><field name="model">erpec.asset.disposal</field><field name="arch" type="xml"><form><group><field name="asset_id"/><field name="date"/><field name="sale_line_id"/></group><footer><button name="action_apply" type="object" string="Contabilizar baja" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="reversal_form" model="ir.ui.view"><field name="name">Reversión integral</field><field name="model">erpec.asset.reversal</field><field name="arch" type="xml"><form><group><field name="asset_id"/><field name="date"/></group><footer><button name="action_apply" type="object" string="Revertir asientos del activo" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
</odoo>
