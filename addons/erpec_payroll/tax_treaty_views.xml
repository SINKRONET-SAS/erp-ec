<odoo>
<record id="tax_treaty_company_rule" model="ir.rule">
  <field name="name">Convenios de doble imposición por empresa</field><field name="model_id" ref="model_erpec_payroll_tax_treaty"/>
  <field name="domain_force">[('company_id', 'in', company_ids)]</field>
</record>
<record id="tax_treaty_list" model="ir.ui.view">
  <field name="name">erpec.payroll.tax.treaty.list</field><field name="model">erpec.payroll.tax.treaty</field>
  <field name="arch" type="xml"><list>
    <field name="country_code"/><field name="country_name"/><field name="mechanism"/><field name="rate"/>
    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
  </list></field>
</record>
<record id="tax_treaty_form" model="ir.ui.view">
  <field name="name">erpec.payroll.tax.treaty.form</field><field name="model">erpec.payroll.tax.treaty</field>
  <field name="arch" type="xml"><form><sheet>
    <div class="alert alert-warning" role="status">Caso 11 (DI25-03): no hay una regla genérica de convenios. Registre aquí, con su fuente exacta, el mecanismo que corresponda al país de residencia del empleado; sin un convenio registrado, el cierre sigue bloqueado.</div>
    <group>
      <field name="company_id" groups="base.group_multi_company"/>
      <field name="country_code"/><field name="country_name"/>
      <field name="mechanism"/><field name="rate" invisible="mechanism != 'capped_rate'"/>
      <field name="active"/>
    </group>
    <group><field name="reference"/><field name="note"/></group>
  </sheet></form></field>
</record>
<record id="tax_treaty_action" model="ir.actions.act_window">
  <field name="name">Convenios de doble imposición</field><field name="res_model">erpec.payroll.tax.treaty</field>
  <field name="view_mode">list,form</field>
</record>
<menuitem id="tax_treaty_menu" name="Convenios de doble imposición" parent="payroll_menu" action="tax_treaty_action" sequence="31" groups="group_payroll_manager"/>
</odoo>
