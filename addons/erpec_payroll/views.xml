<odoo>
<record id="period_list" model="ir.ui.view"><field name="name">erpec.payroll.period.list</field><field name="model">erpec.payroll.period</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="year"/><field name="month"/><field name="version"/><field name="state"/></list></field></record>
<record id="period_form" model="ir.ui.view"><field name="name">erpec.payroll.period.form</field><field name="model">erpec.payroll.period</field><field name="arch" type="xml"><form><header>
<button name="action_calculate" type="object" string="Calcular" class="oe_highlight" invisible="state not in ('draft','calculated')"/>
<button name="action_close" type="object" string="Aprobar cierre" invisible="state != 'calculated'"/>
<button name="action_reopen" type="object" string="Corregir novedades" invisible="state != 'calculated'"/>
<button name="action_post" type="object" string="Contabilizar" class="oe_highlight" invisible="state != 'closed'"/>
<button name="action_reverse" type="object" string="Revertir asiento" invisible="state != 'posted'"/>
<button name="action_correct" type="object" string="Crear corrección" invisible="state != 'reversed'"/>
<field name="state" widget="statusbar"/>
</header><sheet><div class="alert alert-info" role="status"><field name="next_action" nolabel="1"/></div>
<group readonly="state != 'draft'"><field name="name"/><field name="company_id"/><field name="policy_id" domain="[('company_id','=',company_id)]"/><field name="year"/><field name="month"/><field name="version" readonly="1"/></group>
<group><field name="move_id"/><field name="reversal_id"/><field name="correction_of_id"/></group>
<p>Revisa cada empleado y marca sus novedades como aprobadas antes de calcular. Para cambiar un cálculo, utiliza Corregir novedades.</p>
<field name="line_ids" readonly="state != 'draft'"><list><field name="employee_id"/><field name="wage"/><field name="approved"/><field name="gross"/><field name="deductions"/><field name="net"/><field name="cost"/></list>
<form><sheet><group><field name="employee_id"/><field name="partner_id"/><field name="analytic_id"/><field name="start_date"/><field name="wage"/><field name="approved"/></group>
<notebook><page string="Ingresos y tiempo"><group><field name="bonus"/><field name="commission"/><field name="non_taxable_income"/><field name="hours_50"/><field name="hours_100"/><field name="night_hours"/></group></page>
<page string="Descuentos y beneficios"><group><field name="advances"/><field name="loans"/><field name="other_deductions"/><field name="personal_expenses"/><field name="monthly_thirteenth"/><field name="monthly_fourteenth"/><field name="reserve_paid"/></group></page>
<page string="Anexo RDEP" groups="erpec_payroll.group_payroll_manager"><div class="alert alert-info">Novedades anuales declaradas por el responsable de nómina para el anexo RDEP; no se calculan automáticamente. Ver docs/ALCANCE_ATS_RDEP.md.</div>
<group string="Ingresos declarados"><field name="annual_profit_sharing"/><field name="decent_wage_compensation"/><field name="other_employer_taxable_income"/><field name="other_general_interest_income"/></group>
<group string="Otros empleadores y contrato de ingreso neto"><field name="other_employer_iess"/><field name="other_employer_withheld_tax"/><field name="employer_assumed_tax"/></group>
<group string="Gastos personales desglosados"><field name="expense_housing"/><field name="expense_health"/><field name="expense_education"/><field name="expense_food"/><field name="expense_clothing"/><field name="expense_art_culture"/><field name="expense_tourism"/></group></page>
<page string="Resultado"><group><field name="gross"/><field name="deductions"/><field name="net"/><field name="cost"/></group></page></notebook></sheet></form></field>
</sheet><chatter/></form></field></record>
<record id="policy_form" model="ir.ui.view"><field name="name">erpec.payroll.policy.form</field><field name="model">erpec.payroll.policy</field><field name="arch" type="xml"><form><header><button name="action_activate" type="object" string="Activar versión de ensayo" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet>
<div class="alert alert-warning" role="status">Datos de demostración con parámetros laborales reales de la versión indicada. Revisa los valores y fuentes; la migración productiva desde SKNOMINA sigue pendiente.</div>
<group><field name="name"/><field name="company_id"/><field name="year"/><field name="authority"/><field name="synthetic"/><field name="journal_id"/></group>
<notebook><page string="Parámetros aplicados"><field name="parameter_summary"/></page><page string="Decisión y fuentes"><field name="authorization"/><field name="source_reference"/></page><page string="Cuentas"><field name="mapping_ids"><list editable="bottom"><field name="concept"/><field name="debit_id"/><field name="credit_id"/></list></field></page><page string="Configuración técnica" groups="base.group_system"><field name="parameters"/></page></notebook>
</sheet><chatter/></form></field></record>
<record id="company_rdep" model="ir.ui.view"><field name="name">res.company.erpec.payroll.rdep</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Anexo RDEP" groups="erpec_payroll.group_payroll_manager"><div class="alert alert-info">Clasificación de la empresa para el agregador RDEP. No genera ni presenta el anexo; ver docs/ALCANCE_ATS_RDEP.md.</div><group><field name="ec_rdep_employer_type"/><field name="ec_rdep_social_security_entity"/></group></page></xpath></field></record>
<record id="employee_rdep" model="ir.ui.view"><field name="name">hr.employee.erpec.payroll.rdep</field><field name="model">hr.employee</field><field name="inherit_id" ref="hr.view_employee_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Anexo RDEP" groups="erpec_payroll.group_payroll_manager"><div class="alert alert-info">Datos para el agregador RDEP del empleado. Residencia fiscal, país de residencia y otros campos del esquema SRI quedan pendientes; no se completan con datos inventados.</div><group><field name="ec_rdep_id_type"/><field name="ec_rdep_establishment"/><field name="ec_rdep_fiscal_residence"/><field name="ec_rdep_residence_country"/><field name="ec_rdep_treaty_applies"/><field name="ec_rdep_ben_galpg"/><field name="ec_rdep_dependents_count"/></group>
<group string="Discapacidad"><field name="ec_rdep_disability_type"/><field name="ec_rdep_disability_percentage" invisible="ec_rdep_disability_type in (False,'04')"/><field name="ec_rdep_disability_id_type" invisible="ec_rdep_disability_type in (False,'04')"/><field name="ec_rdep_disability_id" invisible="ec_rdep_disability_type in (False,'04')"/></group></page></xpath></field></record>
<record id="rdep_list" model="ir.ui.view"><field name="name">erpec.payroll.rdep.list</field><field name="model">erpec.payroll.rdep</field><field name="arch" type="xml"><list><field name="company_id"/><field name="year"/><field name="state"/></list></field></record>
<record id="rdep_form" model="ir.ui.view"><field name="name">erpec.payroll.rdep.form</field><field name="model">erpec.payroll.rdep</field><field name="arch" type="xml"><form><header><button name="action_build" type="object" string="Agregar períodos contabilizados" class="oe_highlight"/><button name="action_generate_xml" type="object" string="Generar vista previa XML" class="oe_highlight" invisible="not line_ids"/><field name="state" widget="statusbar"/></header><sheet>
<div class="alert alert-warning" role="status"><field name="pending_notice" nolabel="1"/></div>
<group><field name="company_id"/><field name="year"/></group>
<group invisible="not xml_file"><field name="filename"/><field name="digest"/><field name="xml_file" filename="filename"/></group>
<field name="line_ids"><list editable="bottom" create="false" delete="false"><field name="employee_id"/><field name="months"/><field name="salary"/><field name="thirteenth"/><field name="fourteenth"/><field name="reserve_iess"/><field name="personal_iess"/><field name="tax"/></list>
<form><sheet><group><field name="employee_id" readonly="1"/><field name="months" readonly="1"/></group>
<group string="Ingresos"><field name="salary" readonly="1"/><field name="bonus_commission" readonly="1"/><field name="overtime" readonly="1"/><field name="annual_profit_sharing" readonly="1"/><field name="decent_wage_compensation" readonly="1"/><field name="other_employer_taxable_income" readonly="1"/><field name="other_general_interest_income" readonly="1"/><field name="thirteenth" readonly="1"/><field name="fourteenth" readonly="1"/><field name="base" readonly="1"/></group>
<group string="Gastos y aportes"><field name="reserve_iess" readonly="1"/><field name="personal_iess" readonly="1"/><field name="other_employer_iess" readonly="1"/><field name="expense_housing" readonly="1"/><field name="expense_health" readonly="1"/><field name="expense_education" readonly="1"/><field name="expense_food" readonly="1"/><field name="expense_clothing" readonly="1"/><field name="expense_art_culture" readonly="1"/><field name="expense_tourism" readonly="1"/></group>
<group string="Resumen impositivo"><field name="annual_tax_caused" readonly="1"/><field name="personal_expense_rebate" readonly="1"/><field name="annual_tax_after_rebate" readonly="1"/><field name="other_employer_withheld_tax" readonly="1"/><field name="employer_assumed_tax" readonly="1"/><field name="tax" readonly="1"/></group>
</sheet></form></field>
</sheet><chatter/></form></field></record>
<record id="rdep_action" model="ir.actions.act_window"><field name="name">Agregador RDEP</field><field name="res_model">erpec.payroll.rdep</field><field name="view_mode">list,form</field></record>
<record id="period_action" model="ir.actions.act_window"><field name="name">Nómina local</field><field name="res_model">erpec.payroll.period</field><field name="view_mode">list,form</field></record>
<record id="policy_action" model="ir.actions.act_window"><field name="name">Versiones y autoridad</field><field name="res_model">erpec.payroll.policy</field><field name="view_mode">list,form</field></record>
<menuitem id="payroll_menu" name="Nómina local" groups="group_payroll_manager" sequence="57"/>
<menuitem id="period_menu" name="Períodos y novedades" parent="payroll_menu" action="period_action" sequence="10"/>
<menuitem id="policy_menu" name="Versiones y autoridad" parent="payroll_menu" action="policy_action" sequence="20"/>
<menuitem id="rdep_menu" name="Agregador RDEP" parent="payroll_menu" action="rdep_action" sequence="30"/>
</odoo>