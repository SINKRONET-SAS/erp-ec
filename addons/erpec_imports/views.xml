<odoo>
<record id="import_list" model="ir.ui.view"><field name="name">erpec.importation.list</field><field name="model">erpec.importation</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="partner_id"/><field name="currency_id"/><field name="shipment"/><field name="arrival_on"/></list></field></record>
<record id="import_form" model="ir.ui.view"><field name="name">erpec.importation.form</field><field name="model">erpec.importation</field><field name="arch" type="xml"><form><field name="has_prepared_costs" invisible="1"/><header><button name="action_prepare_cost" type="object" string="Preparar distribución de costos" class="btn-primary" groups="account.group_account_manager"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="partner_id"/><field name="currency_id"/><field name="incoterm_id"/><field name="transport"/><field name="shipment"/><field name="shipped_on"/><field name="arrival_on"/><field name="customs_reference"/><field name="attachment_ids" widget="many2many_binary"/></group><div class="alert alert-warning" role="status"><field name="regulatory_note" nolabel="1"/></div><notebook><page string="Compras y recepciones"><field name="purchase_ids" groups="purchase.group_purchase_user"/><field name="picking_ids"/></page><page string="Gastos y tributos" groups="account.group_account_manager"><field name="charge_ids"><list editable="bottom"><field name="name"/><field name="kind"/><field name="bill_line_id"/><field name="split_method"/><field name="amount"/><field name="cost_id"/></list></field></page><page string="Valoración y asientos" groups="stock.group_stock_manager"><field name="cost_ids"/></page></notebook></sheet><chatter/></form></field></record>
<record id="import_action" model="ir.actions.act_window"><field name="name">Importaciones comerciales</field><field name="res_model">erpec.importation</field><field name="view_mode">list,form</field></record>
<menuitem id="import_menu" name="Importaciones comerciales" action="import_action" sequence="12" groups="stock.group_stock_user,account.group_account_manager"/>
<record id="cost_import_form" model="ir.ui.view"><field name="name">erpec.cost.importation</field><field name="model">stock.landed.cost</field><field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group><field name="erpec_import_id"/><field name="erpec_reversal_of_id"/></group><button name="action_erpec_reverse" type="object" string="Preparar ajuste inverso" invisible="not erpec_import_id or state != 'done' or erpec_reversal_of_id"/></xpath></field></record>
</odoo>