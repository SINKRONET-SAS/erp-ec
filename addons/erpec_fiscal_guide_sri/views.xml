<odoo>
<record id="guide_list" model="ir.ui.view"><field name="name">erpec.fiscal.guide.list</field><field name="model">erpec.fiscal.guide</field><field name="arch" type="xml"><list decoration-success="state == 'emitted'"><field name="sri_number"/><field name="partner_id"/><field name="carrier_name"/><field name="plate"/><field name="date_start"/><field name="point_id"/><field name="ambiente"/><field name="state"/></list></field></record>
<record id="guide_form" model="ir.ui.view"><field name="name">erpec.fiscal.guide.form</field><field name="model">erpec.fiscal.guide</field><field name="arch" type="xml"><form>
<header><button name="action_sri_emit" type="object" string="Firmar y emitir al SRI" class="oe_highlight" invisible="state == 'emitted' or not id" confirm="Se firmará la guía con el certificado de la empresa y se transmitirá al SRI. Debe emitirse antes de iniciar el traslado."/><field name="state" widget="statusbar"/></header>
<sheet>
<div class="alert alert-info" role="status">La guía de remisión sustenta el traslado de bienes. Debe emitirse antes de que inicie el traslado; el número se toma del consecutivo del punto de emisión en su ambiente (pruebas o producción).</div>
<group><group string="Emisión"><field name="company_id"/><field name="point_id"/><field name="ambiente"/><field name="sri_number"/><field name="picking_id"/></group><group string="Sustento"><field name="move_id"/><field name="support_authorization"/></group></group>
<group><group string="Destinatario"><field name="partner_id"/><field name="recipient_address"/><field name="reason"/></group><group string="Transporte"><field name="origin_address"/><field name="carrier_name"/><field name="carrier_type"/><field name="carrier_vat"/><field name="plate"/><field name="date_start"/><field name="date_end"/></group></group>
<field name="line_ids"><list editable="bottom"><field name="code"/><field name="description"/><field name="quantity"/></list></field>
</sheet></form></field></record>
<record id="guide_action" model="ir.actions.act_window"><field name="name">Guías de remisión</field><field name="res_model">erpec.fiscal.guide</field><field name="view_mode">list,form</field></record>
<menuitem id="guide_menu" name="Guías de remisión (firma + SRI)" parent="erpec_fiscal_connector.fiscal_root" action="guide_action" sequence="3" groups="account.group_account_user,stock.group_stock_user"/>
<record id="picking_guide_button" model="ir.ui.view"><field name="name">stock.picking.sri.guide</field><field name="model">stock.picking</field><field name="inherit_id" ref="stock.view_picking_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_create_sri_guide" type="object" string="Guía de remisión SRI" invisible="state in ('draft','cancel')"/></xpath></field></record>
<record id="emission_guide_form" model="ir.ui.view"><field name="name">erpec.fiscal.emission.guide</field><field name="model">erpec.fiscal.emission</field><field name="inherit_id" ref="erpec_fiscal_sri.emission_form"/><field name="arch" type="xml"><xpath expr="//field[@name='move_id']" position="after"><field name="guide_id"/></xpath></field></record>
</odoo>
